from __future__ import annotations

from typing import TYPE_CHECKING, Any

from .base import TelegramObject


class WidgetQueryType(TelegramObject):
    """
    This object describes the type of a query from a widget. Currently, it can be one of

     - :class:`litegram.types.widget_query_type_data.WidgetQueryTypeData`
     - :class:`litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData`
     - :class:`litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction`

    Source: https://core.telegram.org/bots/api#widgetquerytype
    """
