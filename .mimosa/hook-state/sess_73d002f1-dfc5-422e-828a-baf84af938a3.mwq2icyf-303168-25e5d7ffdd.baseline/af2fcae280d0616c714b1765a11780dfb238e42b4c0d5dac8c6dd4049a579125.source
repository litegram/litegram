from __future__ import annotations

from typing import TYPE_CHECKING, Any

from .base import TelegramObject


class RichBlock(TelegramObject):
    """
    This object represents a block in a rich formatted message. Currently, it can be any of the following types:

     - :class:`litegram.types.rich_block_paragraph.RichBlockParagraph`
     - :class:`litegram.types.rich_block_section_heading.RichBlockSectionHeading`
     - :class:`litegram.types.rich_block_preformatted.RichBlockPreformatted`
     - :class:`litegram.types.rich_block_footer.RichBlockFooter`
     - :class:`litegram.types.rich_block_divider.RichBlockDivider`
     - :class:`litegram.types.rich_block_mathematical_expression.RichBlockMathematicalExpression`
     - :class:`litegram.types.rich_block_anchor.RichBlockAnchor`
     - :class:`litegram.types.rich_block_list.RichBlockList`
     - :class:`litegram.types.rich_block_block_quotation.RichBlockBlockQuotation`
     - :class:`litegram.types.rich_block_expandable_block_quotation.RichBlockExpandableBlockQuotation`
     - :class:`litegram.types.rich_block_pull_quotation.RichBlockPullQuotation`
     - :class:`litegram.types.rich_block_collage.RichBlockCollage`
     - :class:`litegram.types.rich_block_slideshow.RichBlockSlideshow`
     - :class:`litegram.types.rich_block_table.RichBlockTable`
     - :class:`litegram.types.rich_block_details.RichBlockDetails`
     - :class:`litegram.types.rich_block_map.RichBlockMap`
     - :class:`litegram.types.rich_block_buttons.RichBlockButtons`
     - :class:`litegram.types.rich_block_animation.RichBlockAnimation`
     - :class:`litegram.types.rich_block_audio.RichBlockAudio`
     - :class:`litegram.types.rich_block_document.RichBlockDocument`
     - :class:`litegram.types.rich_block_photo.RichBlockPhoto`
     - :class:`litegram.types.rich_block_video.RichBlockVideo`
     - :class:`litegram.types.rich_block_voice_note.RichBlockVoiceNote`
     - :class:`litegram.types.rich_block_thinking.RichBlockThinking`

    Source: https://core.telegram.org/bots/api#richblock
    """
