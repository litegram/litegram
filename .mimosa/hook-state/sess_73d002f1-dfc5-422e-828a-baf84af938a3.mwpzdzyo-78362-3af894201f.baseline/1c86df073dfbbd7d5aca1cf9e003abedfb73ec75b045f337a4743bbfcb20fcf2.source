from __future__ import annotations

from contextlib import aclosing
from mimetypes import guess_type
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import AsyncGenerator, Mapping


def _quote_parameter(value: str) -> str:
    # Keep control characters out of MIME headers, including CR and LF.
    return "".join(f"%{ord(char):02X}" if char == '"' or not char.isprintable() else char.replace("\\", "\\\\") for char in value)


async def iter_multipart(
    boundary: str,
    fields: Mapping[str, str],
    files: Mapping[str, tuple[str, AsyncGenerator[bytes]]],
) -> AsyncGenerator[bytes]:
    delimiter = f"--{boundary}\r\n"
    for name, value in fields.items():
        yield f'{delimiter}Content-Disposition: form-data; name="{_quote_parameter(name)}"\r\n\r\n{value}\r\n'.encode()
    for name, (filename, reader) in files.items():
        content_type = guess_type(filename)[0] or "application/octet-stream"
        async with aclosing(reader):
            yield (
                f'{delimiter}Content-Disposition: form-data; name="{_quote_parameter(name)}"; '
                f'filename="{_quote_parameter(filename)}"\r\nContent-Type: {content_type}\r\n\r\n'
            ).encode()
            async for chunk in reader:
                if chunk:
                    yield chunk
        yield b"\r\n"
    yield f"--{boundary}--\r\n".encode()
