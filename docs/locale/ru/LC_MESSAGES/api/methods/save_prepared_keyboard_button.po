#: ../../api/methods/save_prepared_keyboard_button.rst:3
msgid "savePreparedKeyboardButton"
msgstr ""

#: litegram.methods.save_prepared_keyboard_button.SavePreparedKeyboardButton:1
#: of
msgid ""
"Stores a keyboard button that can be used by a user within a Mini App. "
"Returns a "
":class:`litegram.types.prepared_keyboard_button.PreparedKeyboardButton` "
"object."
msgstr ""
"Сохраняет кнопку клавиатуры, которую пользователь сможет использовать в "
"Mini App. Возвращает объект "
":class:`litegram.types.prepared_keyboard_button.PreparedKeyboardButton`."

#: litegram.methods.save_prepared_keyboard_button.SavePreparedKeyboardButton:3
#: of
msgid "Source: https://core.telegram.org/bots/api#savepreparedkeyboardbutton"
msgstr "Источник: https://core.telegram.org/bots/api#savepreparedkeyboardbutton"

#: litegram.methods.save_prepared_keyboard_button.SavePreparedKeyboardButton.user_id:1
#: of
msgid "Unique identifier of the target user that can use the button"
msgstr "Уникальный идентификатор пользователя, который сможет использовать кнопку"

#: litegram.methods.save_prepared_keyboard_button.SavePreparedKeyboardButton.button:1
#: of
msgid ""
"A JSON-serialized object describing the button to be saved. The button "
"must be of the type *request_users*, *request_chat*, or "
"*request_managed_bot*."
msgstr ""
"Объект в формате JSON, описывающий сохраняемую кнопку. Допустимые типы "
"кнопки: *request_users*, *request_chat* или *request_managed_bot*."

