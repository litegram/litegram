#: ../../api/methods/set_chat_member_tag.rst:3
msgid "setChatMemberTag"
msgstr ""

#: litegram.methods.set_chat_member_tag.SetChatMemberTag:1 of
msgid ""
"Use this method to set a tag for a regular member in a group or a "
"supergroup. The bot must be an administrator in the chat for this to work"
" and must have the *can_manage_tags* administrator right. Returns "
":code:`True` on success."
msgstr ""
"Устанавливает тег обычного участника группы или супергруппы. Бот должен "
"быть администратором чата с правом *can_manage_tags*. При успехе "
"возвращает :code:`True`."

#: litegram.methods.set_chat_member_tag.SetChatMemberTag:3 of
msgid "Source: https://core.telegram.org/bots/api#setchatmembertag"
msgstr "Источник: https://core.telegram.org/bots/api#setchatmembertag"

#: litegram.methods.set_chat_member_tag.SetChatMemberTag.chat_id:1 of
msgid ""
"Unique identifier for the target chat or username of the target "
"supergroup in the format :code:`@username`"
msgstr ""
"Уникальный идентификатор целевого чата или имя целевой супергруппы в "
"формате :code:`@username`"

#: litegram.methods.set_chat_member_tag.SetChatMemberTag.user_id:1 of
msgid "Unique identifier of the target user"
msgstr "Уникальный идентификатор целевого пользователя"

#: litegram.methods.set_chat_member_tag.SetChatMemberTag.tag:1 of
msgid "New tag for the member; 0-16 characters, emoji are not allowed"
msgstr "Новый тег участника, от 0 до 16 символов; эмодзи не допускаются"

