#: ../../api/methods/get_managed_bot_token.rst:3
msgid "getManagedBotToken"
msgstr ""

#: litegram.methods.get_managed_bot_token.GetManagedBotToken:1 of
msgid ""
"Use this method to get the token of a managed bot. Returns the token as "
"*String* on success."
msgstr "Получает токен управляемого бота. При успехе возвращает токен строкой."

#: litegram.methods.get_managed_bot_token.GetManagedBotToken:3 of
msgid "Source: https://core.telegram.org/bots/api#getmanagedbottoken"
msgstr "Источник: https://core.telegram.org/bots/api#getmanagedbottoken"

#: litegram.methods.get_managed_bot_token.GetManagedBotToken.user_id:1 of
msgid "User identifier of the managed bot whose token will be returned"
msgstr ""
"Идентификатор пользователя, соответствующего управляемому боту, токен "
"которого нужно получить"

