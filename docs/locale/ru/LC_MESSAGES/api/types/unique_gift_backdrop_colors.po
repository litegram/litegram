msgid "UniqueGiftBackdropColors"
msgstr "UniqueGiftBackdropColors"

#: litegram.types.unique_gift_backdrop_colors.UniqueGiftBackdropColors:1 of
msgid "This object describes the colors of the backdrop of a unique gift."
msgstr "Этот объект описывает цвета подложки уникального подарка."

#: litegram.types.unique_gift_backdrop_colors.UniqueGiftBackdropColors:3 of
msgid "Source: https://core.telegram.org/bots/api#uniquegiftbackdropcolors"
