#: ../../api/types/inline_query_result_document.rst:3
msgid "InlineQueryResultDocument"
msgstr "InlineQueryResultDocument"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument:1 of
msgid ""
"Represents a link to a file. By default, this file will be sent by the user "
"with an optional caption. Alternatively, you can use *input_message_content* "
"to send a message with the specified content instead of the file. Currently, "
"only **.PDF** and **.ZIP** files can be sent using this method."
msgstr ""
"Представляет ссылку на файл. По умолчанию этот файл будет отправлен "
"пользователем с необязательной подписью. В качестве альтернативы можно "
"использовать *input_message_content*, чтобы отправить сообщение с указанным "
"содержимым вместо файла. Сейчас с помощью этого метода можно отправлять "
"только файлы **.PDF** и **.ZIP**."

#: litegram.types.inline_query_result_document.InlineQueryResultDocument:3 of
msgid "Source: https://core.telegram.org/bots/api#inlinequeryresultdocument"
msgstr "Источник: https://core.telegram.org/bots/api#inlinequeryresultdocument"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.type:1
#: of
msgid "Type of the result, must be *document*"
msgstr "Тип результата; должно быть *document*"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.id:1
#: of
msgid "Unique identifier for this result, 1-64 bytes"
msgstr "Уникальный идентификатор этого результата, 1-64 байта"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.title:1
#: of
msgid "Title for the result"
msgstr "Название результата"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.document_url:1
#: of
msgid "A valid URL for the file"
msgstr "Корректный URL файла"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.mime_type:1
#: of
msgid ""
"MIME type of the content of the file, either 'application/pdf' or "
"'application/zip'"
msgstr "MIME-тип содержимого файла, 'application/pdf' или 'application/zip'"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.caption:1
#: of
msgid ""
"*Optional*. Caption of the document to be sent, 0-1024 characters after "
"entities parsing"
msgstr ""
"*Необязательно*. Подпись отправляемого документа, 0-1024 символа после "
"разбора сущностей"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.parse_mode:1
#: of
msgid ""
"*Optional*. Mode for parsing entities in the document caption. See "
"`formatting options <https://core.telegram.org/bots/api#formatting-options>`_"
" for more details."
msgstr ""
"*Необязательно*. Режим разбора сущностей в подписи документа. Подробнее см. "
"`варианты форматирования <https://core.telegram.org/bots/api#formatting-"
"options>`_."

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.caption_entities:1
#: of
msgid ""
"*Optional*. List of special entities that appear in the caption, which can be"
" specified instead of *parse_mode*"
msgstr ""
"*Необязательно*. Список специальных сущностей в подписи; можно указать вместо"
" *parse_mode*"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.description:1
#: of
msgid "*Optional*. Short description of the result"
msgstr "*Необязательно*. Краткое описание результата"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.reply_markup:1
#: of
msgid ""
"*Optional*. `Inline keyboard <https://core.telegram.org/bots/features#inline-"
"keyboards>`_ attached to the message"
msgstr ""
"*Необязательно*. `Inline-клавиатура "
"<https://core.telegram.org/bots/features#inline-keyboards>`_, прикреплённая к"
" сообщению"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.input_message_content:1
#: of
msgid "*Optional*. Content of the message to be sent instead of the file"
msgstr ""
"*Необязательно*. Содержимое сообщения, которое будет отправлено вместо файла"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.thumbnail_url:1
#: of
msgid "*Optional*. URL of the thumbnail (JPEG only) for the file"
msgstr "*Необязательно*. URL превью (только JPEG) для файла"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.thumbnail_width:1
#: of
msgid "*Optional*. Thumbnail width"
msgstr "*Необязательно*. Ширина превью"

#: litegram.types.inline_query_result_document.InlineQueryResultDocument.thumbnail_height:1
#: of
msgid "*Optional*. Thumbnail height"
msgstr "*Необязательно*. Высота превью"

#~ msgid "*Optional*. Inline keyboard attached to the message"
#~ msgstr ""
