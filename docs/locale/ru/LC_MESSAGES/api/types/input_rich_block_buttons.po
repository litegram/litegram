#: ../../api/types/input_rich_block_buttons.rst:3
msgid "InputRichBlockButtons"
msgstr "InputRichBlockButtons"

#: litegram.types.input_rich_block_buttons.InputRichBlockButtons:1 of
msgid ""
"A block containing a list of buttons that are shown in one row, "
"corresponding to the custom HTML tag :code:`<tg-button-row>`."
msgstr ""
"Блок со списком кнопок, отображаемых в одну строку; соответствует "
"пользовательскому HTML-тегу :code:`<tg-button-row>`."

#: litegram.types.input_rich_block_buttons.InputRichBlockButtons:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockbuttons"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockbuttons"

#: litegram.types.input_rich_block_buttons.InputRichBlockButtons.type:1 of
msgid "Type of the block, always 'buttons'"
msgstr "Тип блока, всегда 'buttons'"

#: litegram.types.input_rich_block_buttons.InputRichBlockButtons.buttons:1 of
msgid "List of 1-8 buttons to send"
msgstr "Список из 1–8 кнопок для отправки"

#: litegram.types.input_rich_block_buttons.InputRichBlockButtons.align:1 of
msgid ""
"*Optional*. Horizontal alignment of the buttons. Currently, must be one "
"of 'left', 'center', or 'right'."
msgstr ""
"*Необязательно*. Горизонтальное выравнивание кнопок. Допустимые значения:"
" 'left', 'center' или 'right'."

