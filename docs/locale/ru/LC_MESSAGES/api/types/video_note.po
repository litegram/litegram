#: ../../api/types/video_note.rst:3
msgid "VideoNote"
msgstr "VideoNote"

#: litegram.types.video_note.VideoNote:1 of
msgid ""
"This object represents a `video message <https://telegram.org/blog/video-"
"messages-and-telescope>`_."
msgstr ""
"Этот объект представляет `видеосообщение <https://telegram.org/blog/video-"
"messages-and-telescope>`_."

#: litegram.types.video_note.VideoNote:3 of
msgid "Source: https://core.telegram.org/bots/api#videonote"
msgstr "Источник: https://core.telegram.org/bots/api#videonote"

#: litegram.types.video_note.VideoNote.file_id:1 of
msgid ""
"Identifier for this file, which can be used to download or reuse the file"
msgstr ""
"Идентификатор файла, который можно использовать для скачивания или повторной "
"отправки файла"

#: litegram.types.video_note.VideoNote.file_unique_id:1 of
msgid ""
"Unique identifier for this file, which is supposed to be the same over time "
"and for different bots. Can't be used to download or reuse the file."
msgstr ""
"Уникальный идентификатор этого файла, который должен оставаться одинаковым со"
" временем и для разных ботов. Нельзя использовать для скачивания или "
"повторной отправки файла."

#: litegram.types.video_note.VideoNote.length:1 of
msgid ""
"Video width and height (diameter of the video message) as defined by the "
"sender"
msgstr "Ширина и высота видео (диаметр видеосообщения), заданные отправителем"

#: litegram.types.video_note.VideoNote.duration:1 of
msgid "Duration of the video in seconds as defined by the sender"
msgstr "Длительность видео в секундах, заданная отправителем"

#: litegram.types.video_note.VideoNote.thumbnail:1 of
msgid "*Optional*. Video thumbnail"
msgstr "*Необязательно*. Превью видео"

#: litegram.types.video_note.VideoNote.file_size:1 of
msgid "*Optional*. File size in bytes"
msgstr "*Необязательно*. Размер файла в байтах"

#~ msgid ""
#~ "This object represents a `video message <https://telegram.org/blog/video-"
#~ "messages-and-telescope>`_ (available in Telegram apps as of `v.4.0 "
#~ "<https://telegram.org/blog/video-messages-and-telescope>`_)."
#~ msgstr ""
