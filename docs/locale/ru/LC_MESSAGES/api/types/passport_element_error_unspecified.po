#: ../../docstring
#: litegram.types.passport_element_error_unspecified.PassportElementErrorUnspecified.type:1
#: of
msgid "Type of element of the user's Telegram Passport which has the issue"
msgstr "Тип элемента Telegram Passport пользователя, в котором проблема"

