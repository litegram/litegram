msgid "PassportElementErrorUnspecified"
msgstr "PassportElementErrorUnspecified"

#: litegram.types.passport_element_error_unspecified.PassportElementErrorUnspecified:1
#: of
msgid ""
"Represents an issue in an unspecified place. The error is considered resolved"
" when new data is added."
msgstr ""
"Представляет проблему в неуказанном месте. Ошибка считается решённой, когда "
"добавлены новые данные."

#: litegram.types.passport_element_error_unspecified.PassportElementErrorUnspecified:3
#: of
