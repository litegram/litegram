#: ../../api/types/input_rich_block_document.rst:3
msgid "InputRichBlockDocument"
msgstr "InputRichBlockDocument"

#: litegram.types.input_rich_block_document.InputRichBlockDocument:1 of
msgid ""
"A block with a general file, corresponding to the custom HTML tag :code"
":`<tg-document>`."
msgstr ""
"Блок с произвольным файлом; соответствует пользовательскому HTML-тегу "
":code:`<tg-document>`."

#: litegram.types.input_rich_block_document.InputRichBlockDocument:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockdocument"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockdocument"

#: litegram.types.input_rich_block_document.InputRichBlockDocument.type:1 of
msgid "Type of the block, always 'document'"
msgstr "Тип блока, всегда 'document'"

#: litegram.types.input_rich_block_document.InputRichBlockDocument.document:1
#: of
msgid "The document. Caption is ignored."
msgstr "Документ. Подпись игнорируется."

#: litegram.types.input_rich_block_document.InputRichBlockDocument.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

