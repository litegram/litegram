#: ../../api/types/area_position.rst:3
msgid "AreaPosition"
msgstr "AreaPosition"

#: litegram.types.area_position.AreaPosition:1 of
msgid ""
"Describes the position of a rectangle area on a story media or a TON "
"wallet card."
msgstr ""
"Описывает положение прямоугольной области на медиа сторис или карточке "
"TON-кошелька."

#: litegram.types.area_position.AreaPosition:3 of
msgid "Source: https://core.telegram.org/bots/api#areaposition"
msgstr "Источник: https://core.telegram.org/bots/api#areaposition"

#: litegram.types.area_position.AreaPosition.x_percentage:1 of
msgid ""
"The abscissa of the area's center, as a percentage of the media or the "
"card width"
msgstr "Абсцисса центра области в процентах от ширины медиа или карточки"

#: litegram.types.area_position.AreaPosition.y_percentage:1 of
msgid ""
"The ordinate of the area's center, as a percentage of the media or the "
"card height"
msgstr "Ордината центра области в процентах от высоты медиа или карточки"

#: litegram.types.area_position.AreaPosition.width_percentage:1 of
msgid ""
"The width of the area's rectangle, as a percentage of the media or the "
"card width"
msgstr "Ширина прямоугольника области в процентах от ширины медиа или карточки"

#: litegram.types.area_position.AreaPosition.height_percentage:1 of
msgid ""
"The height of the area's rectangle, as a percentage of the media or the "
"card height"
msgstr "Высота прямоугольника области в процентах от высоты медиа или карточки"

#: litegram.types.area_position.AreaPosition.rotation_angle:1 of
msgid "The clockwise rotation angle of the rectangle, in degrees; 0-360"
msgstr "Угол поворота прямоугольника по часовой стрелке в градусах; от 0 до 360"

#: litegram.types.area_position.AreaPosition.corner_radius_percentage:1 of
msgid ""
"The radius of the rectangle corner rounding, as a percentage of the media"
" or the card width"
msgstr ""
"Радиус скругления углов прямоугольника в процентах от ширины медиа или "
"карточки"

