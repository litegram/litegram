msgstr "Широта места"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:11
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:11 of
msgid "Longitude of the venue"
msgstr "Долгота места"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:12
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:12 of
msgid "Name of the venue"
msgstr "Название места"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:13
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:13 of
msgid "Address of the venue"
msgstr "Адрес места"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:17
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:17 of
msgid "Foursquare identifier of the venue"
msgstr "Идентификатор места в Foursquare"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:18
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:18 of
msgid ""
"Foursquare type of the venue, if known. (For example, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' or "
"'food/icecream'.)"
msgstr ""
"Тип места в Foursquare, если известен (например, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' или "
"'food/icecream')."

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:19
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:19 of
msgid "Google Places identifier of the venue"
msgstr "Идентификатор места в Google Places"

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:20
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:20 of
msgid ""
"Google Places type of the venue. (See `supported types "
"<https://developers.google.com/places/web-service/supported_types>`_.)"
msgstr ""
"Тип места в Google Places (см. `поддерживаемые типы "
"<https://developers.google.com/places/web-service/supported_types>`_)."

#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue:30
#: litegram.types.chat_join_request.ChatJoinRequest.answer_venue_pm:30 of
