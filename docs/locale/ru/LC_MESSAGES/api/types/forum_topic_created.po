#: ../../api/types/forum_topic_created.rst:3
msgid "ForumTopicCreated"
msgstr "ForumTopicCreated"

#: litegram.types.forum_topic_created.ForumTopicCreated:1 of
msgid ""
"This object represents a service message about a new forum topic created in "
"the chat."
msgstr ""
"Этот объект представляет сервисное сообщение о создании новой темы форума в "
"чате."

#: litegram.types.forum_topic_created.ForumTopicCreated:3 of
msgid "Source: https://core.telegram.org/bots/api#forumtopiccreated"
msgstr "Источник: https://core.telegram.org/bots/api#forumtopiccreated"

#: litegram.types.forum_topic_created.ForumTopicCreated.name:1 of
msgid "Name of the topic"
msgstr "Название темы"

#: litegram.types.forum_topic_created.ForumTopicCreated.icon_color:1 of
msgid "Color of the topic icon in RGB format"
msgstr "Цвет значка темы в формате RGB"

#: litegram.types.forum_topic_created.ForumTopicCreated.icon_custom_emoji_id:1
#: of
msgid ""
"*Optional*. Unique identifier of the custom emoji shown as the topic icon"
msgstr ""
"*Необязательно*. Уникальный идентификатор кастомного эмодзи, показываемого в "
"качестве значка темы"

#: litegram.types.forum_topic_created.ForumTopicCreated.is_name_implicit:1 of
msgid ""
"*Optional*. :code:`True`, if the name of the topic wasn't specified "
"explicitly by its creator and likely needs to be changed by the bot"
msgstr ""
"*Необязательно*. :code:`True`, если название темы не было явно задано её "
"создателем и, вероятно, должно быть изменено ботом"
