#: ../../api/types/chosen_inline_result.rst:3
msgid "ChosenInlineResult"
msgstr "ChosenInlineResult"

#: litegram.types.chosen_inline_result.ChosenInlineResult:1 of
msgid ""
"Represents a `result <https://core.telegram.org/bots/api#inlinequeryresult>`_"
" of an inline query that was chosen by the user and sent to their chat "
"partner."
msgstr ""
"Представляет `результат "
"<https://core.telegram.org/bots/api#inlinequeryresult>`_ inline-запроса, "
"выбранный пользователем и отправленный его собеседнику."

#: litegram.types.chosen_inline_result.ChosenInlineResult:3 of
msgid "Source: https://core.telegram.org/bots/api#choseninlineresult"
msgstr "Источник: https://core.telegram.org/bots/api#choseninlineresult"

#: litegram.types.chosen_inline_result.ChosenInlineResult.result_id:1 of
msgid "The unique identifier for the result that was chosen"
msgstr "Уникальный идентификатор выбранного результата"

#: litegram.types.chosen_inline_result.ChosenInlineResult.query:1 of
msgid "The query that was used to obtain the result"
msgstr "Запрос, по которому был получен результат"

#: litegram.types.chosen_inline_result.ChosenInlineResult.location:1 of
msgid "*Optional*. Sender location, only for bots that require user location"
msgstr ""
"*Необязательно*. Местоположение отправителя, только для ботов, запрашивающих "
"местоположение пользователя"

#: litegram.types.chosen_inline_result.ChosenInlineResult.inline_message_id:1
#: of
msgid ""
"*Optional*. Identifier of the sent inline message. Available only if there is"
" an `inline keyboard "
"<https://core.telegram.org/bots/api#inlinekeyboardmarkup>`_ attached to the "
"message. Will be also received in `callback queries "
"<https://core.telegram.org/bots/api#callbackquery>`_ and can be used to `edit"
" <https://core.telegram.org/bots/api#updating-messages>`_ the message."
msgstr ""
"*Необязательно*. Идентификатор отправленного inline-сообщения. Доступен, "
"только если к сообщению прикреплена `inline-клавиатура "
"<https://core.telegram.org/bots/api#inlinekeyboardmarkup>`_. Также будет "
"приходить в `запросах обратного вызова "
"<https://core.telegram.org/bots/api#callbackquery>`_ и может использоваться "
"для `редактирования <https://core.telegram.org/bots/api#updating-messages>`_ "
"сообщения."

#: litegram.types.chosen_inline_result.ChosenInlineResult.from_user:1 of
msgid "The user that chose the result"
msgstr "Пользователь, выбравший результат"

#~ msgid ""
#~ "Represents a `result <https://core.telegram.org/bots/api#inlinequeryresult>`_"
#~ " of an inline query that was chosen by the user and sent to their chat "
#~ "partner. **Note:** It is necessary to enable `inline feedback "
#~ "<https://core.telegram.org/bots/inline#collecting-feedback>`_ via `@BotFather"
#~ " <https://t.me/botfather>`_ in order to receive these objects in updates."
#~ msgstr ""
