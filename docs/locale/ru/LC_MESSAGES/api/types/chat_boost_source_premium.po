#: ../../api/types/chat_boost_source_premium.rst:3
msgid "ChatBoostSourcePremium"
msgstr "ChatBoostSourcePremium"

#: litegram.types.chat_boost_source_premium.ChatBoostSourcePremium:1 of
msgid ""
"The boost was obtained by subscribing to Telegram Premium or by gifting a "
"Telegram Premium subscription to another user."
msgstr ""
"Буст получен за оформление подписки Telegram Premium или за дарение подписки "
"Telegram Premium другому пользователю."

#: litegram.types.chat_boost_source_premium.ChatBoostSourcePremium:3 of
msgid "Source: https://core.telegram.org/bots/api#chatboostsourcepremium"
msgstr "Источник: https://core.telegram.org/bots/api#chatboostsourcepremium"

#: ../../docstring
#: litegram.types.chat_boost_source_premium.ChatBoostSourcePremium.source:1 of
msgid "Source of the boost, always 'premium'"
msgstr "Источник буста, всегда 'premium'"

#: ../../docstring
#: litegram.types.chat_boost_source_premium.ChatBoostSourcePremium.user:1 of
msgid "User that boosted the chat"
msgstr "Пользователь, забустировший чат"
