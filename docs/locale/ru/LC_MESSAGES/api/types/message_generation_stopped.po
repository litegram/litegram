#: ../../api/types/message_generation_stopped.rst:3
msgid "MessageGenerationStopped"
msgstr "MessageGenerationStopped"

#: litegram.types.message_generation_stopped.MessageGenerationStopped:1 of
msgid "This object describes an update about a user stopping message generation."
msgstr ""
"Этот объект описывает обновление об остановке пользователем генерации "
"сообщения."

#: litegram.types.message_generation_stopped.MessageGenerationStopped:3 of
msgid "Source: https://core.telegram.org/bots/api#messagegenerationstopped"
msgstr "Источник: https://core.telegram.org/bots/api#messagegenerationstopped"

#: litegram.types.message_generation_stopped.MessageGenerationStopped.chat:1 of
msgid "Chat in which the message is generated"
msgstr "Чат, в котором генерируется сообщение"

#: litegram.types.message_generation_stopped.MessageGenerationStopped.message_thread_id:1
#: of
msgid ""
"*Optional*. Unique identifier of the message thread in which the message "
"is generated"
msgstr ""
"*Необязательно*. Уникальный идентификатор темы, в которой генерируется "
"сообщение"

#: litegram.types.message_generation_stopped.MessageGenerationStopped.draft_id:1
#: of
msgid "Unique identifier of the message draft which was stopped"
msgstr "Уникальный идентификатор остановленного черновика сообщения"

