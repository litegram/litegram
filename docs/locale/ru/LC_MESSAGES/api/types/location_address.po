#: ../../api/types/location_address.rst:3
msgid "LocationAddress"
msgstr "LocationAddress"

#: litegram.types.location_address.LocationAddress:1 of
msgid "Describes the physical address of a location."
msgstr "Описывает физический адрес местоположения."

#: litegram.types.location_address.LocationAddress:3 of
msgid "Source: https://core.telegram.org/bots/api#locationaddress"
msgstr "Источник: https://core.telegram.org/bots/api#locationaddress"

#: litegram.types.location_address.LocationAddress.country_code:1 of
msgid ""
"The two-letter ISO 3166-1 alpha-2 country code of the country where the "
"location is located"
msgstr ""
"Двухбуквенный код страны ISO 3166-1 alpha-2 страны, в которой находится "
"местоположение"

#: litegram.types.location_address.LocationAddress.state:1 of
msgid "*Optional*. State of the location"
msgstr "*Необязательно*. Штат местоположения"

#: litegram.types.location_address.LocationAddress.city:1 of
msgid "*Optional*. City of the location"
msgstr "*Необязательно*. Город местоположения"

#: litegram.types.location_address.LocationAddress.street:1 of
msgid "*Optional*. Street address of the location"
msgstr "*Необязательно*. Почтовый адрес местоположения"
