#: ../../api/types/input_shared_widget_message_content.rst:3
msgid "InputSharedWidgetMessageContent"
msgstr "InputSharedWidgetMessageContent"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent:1
#: of
msgid ""
"Represents the `content "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ of a message "
"with a shared widget to be sent as the result of an inline query. "
"Currently, widgets can't be sent in response to inline queries in the "
"production environment."
msgstr ""
"Представляет `содержимое "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ сообщения с "
"переиспользуемым виджетом, отправляемого как результат inline-запроса. "
"Сейчас виджеты нельзя отправлять в ответ на inline-запросы в рабочем "
"окружении."

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent:3
#: of
msgid "Source: https://core.telegram.org/bots/api#inputsharedwidgetmessagecontent"
msgstr ""
"Источник: "
"https://core.telegram.org/bots/api#inputsharedwidgetmessagecontent"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.widget_id:1
#: of
msgid "Unique identifier of the shared widget created by the bot"
msgstr "Уникальный идентификатор переиспользуемого виджета, созданного ботом"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.chat_data:1
#: of
msgid ""
"*Optional*. Data of the widget, which is specific to the message, 0-1024 "
"bytes"
msgstr ""
"*Необязательно*. Данные виджета для конкретного сообщения, от 0 до 1024 "
"байт"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.caption:1
#: of
msgid "*Optional*. Widget caption, 0-1024 characters after entities parsing"
msgstr ""
"*Необязательно*. Подпись виджета, от 0 до 1024 символов после разбора "
"сущностей"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.parse_mode:1
#: of
msgid ""
"*Optional*. Mode for parsing entities in the widget caption. See "
"`formatting options <https://core.telegram.org/bots/api#formatting-"
"options>`_ for more details."
msgstr ""
"*Необязательно*. Режим разбора сущностей в подписи виджета. Подробнее см."
" `варианты форматирования <https://core.telegram.org/bots/api#formatting-"
"options>`_."

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.caption_entities:1
#: of
msgid ""
"*Optional*. List of special entities that appear in the caption, which "
"can be specified instead of *parse_mode*"
msgstr ""
"*Необязательно*. Список специальных сущностей в подписи; можно передать "
"вместо *parse_mode*"

#: litegram.types.input_shared_widget_message_content.InputSharedWidgetMessageContent.show_caption_above_media:1
#: of
msgid ""
"*Optional*. Pass :code:`True` if the caption must be shown above the "
"widget"
msgstr ""
"*Необязательно*. Передайте :code:`True`, чтобы показать подпись над "
"виджетом"

