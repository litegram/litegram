#: ../../api/types/rich_block_list.rst:3
msgid "RichBlockList"
msgstr "RichBlockList"

#: litegram.types.rich_block_list.RichBlockList:1 of
msgid ""
"A list of blocks, corresponding to the HTML tag :code:`<ul>` or "
":code:`<ol>` with multiple nested tags :code:`<li>`."
msgstr ""
"Список блоков; соответствует HTML-тегу :code:`<ul>` или :code:`<ol>` с "
"несколькими вложенными тегами :code:`<li>`."

#: litegram.types.rich_block_list.RichBlockList:3 of
msgid "Source: https://core.telegram.org/bots/api#richblocklist"
msgstr "Источник: https://core.telegram.org/bots/api#richblocklist"

#: litegram.types.rich_block_list.RichBlockList.type:1 of
msgid "Type of the block, always 'list'"
msgstr "Тип блока, всегда 'list'"

#: litegram.types.rich_block_list.RichBlockList.items:1 of
msgid "Items of the list"
msgstr "Элементы списка"

