#: ../../api/types/inline_query_result_cached_gif.rst:3
msgid "InlineQueryResultCachedGif"
msgstr "InlineQueryResultCachedGif"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif:1
#: of
msgid ""
"Represents a link to an animated GIF file stored on the Telegram servers. By "
"default, this animated GIF file will be sent by the user with an optional "
"caption. Alternatively, you can use *input_message_content* to send a message"
" with specified content instead of the animation."
msgstr ""
"Представляет ссылку на анимированный GIF-файл, хранящийся на серверах "
"Telegram. По умолчанию этот анимированный GIF-файл будет отправлен "
"пользователем с необязательной подписью. В качестве альтернативы можно "
"использовать *input_message_content*, чтобы отправить сообщение с указанным "
"содержимым вместо анимации."

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif:3
#: of
msgid "Source: https://core.telegram.org/bots/api#inlinequeryresultcachedgif"
msgstr ""
"Источник: https://core.telegram.org/bots/api#inlinequeryresultcachedgif"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.type:1
#: of
msgid "Type of the result, must be *gif*"
msgstr "Тип результата; должно быть *gif*"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.id:1
#: of
msgid "Unique identifier for this result, 1-64 bytes"
msgstr "Уникальный идентификатор этого результата, 1-64 байта"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.gif_file_id:1
#: of
msgid "A valid file identifier for the GIF file"
msgstr "Корректный file_id GIF-файла"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.title:1
#: of
msgid "*Optional*. Title for the result"
msgstr "*Необязательно*. Название результата"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.caption:1
#: of
msgid ""
"*Optional*. Caption of the GIF file to be sent, 0-1024 characters after "
"entities parsing"
msgstr ""
"*Необязательно*. Подпись отправляемого GIF-файла, 0-1024 символа после "
"разбора сущностей"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.parse_mode:1
#: of
msgid ""
"*Optional*. Mode for parsing entities in the caption. See `formatting options"
" <https://core.telegram.org/bots/api#formatting-options>`_ for more details."
msgstr ""
"*Необязательно*. Режим разбора сущностей в подписи. Подробнее см. `варианты "
"форматирования <https://core.telegram.org/bots/api#formatting-options>`_."

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.caption_entities:1
#: of
msgid ""
"*Optional*. List of special entities that appear in the caption, which can be"
" specified instead of *parse_mode*"
msgstr ""
"*Необязательно*. Список специальных сущностей в подписи; можно указать вместо"
" *parse_mode*"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.show_caption_above_media:1
#: of
msgid ""
"*Optional*. Pass :code:`True` if the caption must be shown above the message "
"media"
msgstr ""
"*Необязательно*. Передайте :code:`True`, чтобы показать подпись над медиа "
"сообщения"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.reply_markup:1
#: of
msgid ""
"*Optional*. `Inline keyboard <https://core.telegram.org/bots/features#inline-"
"keyboards>`_ attached to the message"
msgstr ""
"*Необязательно*. `Inline-клавиатура "
"<https://core.telegram.org/bots/features#inline-keyboards>`_, прикреплённая к"
" сообщению"

#: litegram.types.inline_query_result_cached_gif.InlineQueryResultCachedGif.input_message_content:1
#: of
msgid ""
"*Optional*. Content of the message to be sent instead of the GIF animation"
msgstr ""
"*Необязательно*. Содержимое сообщения, которое будет отправлено вместо GIF-"
"анимации"

#~ msgid ""
#~ "*Optional*. Pass :code:`True`, if the caption must be shown above the message"
#~ " media"
#~ msgstr ""
