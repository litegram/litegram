#: ../../api/types/chat_share_theme_backdrop.rst:3
msgid "ChatShareThemeBackdrop"
msgstr "ChatShareThemeBackdrop"

#: litegram.types.chat_share_theme_backdrop.ChatShareThemeBackdrop:1 of
msgid ""
"This object describes a backdrop, which can be used as the background of "
"a theme of the screen for sharing a link to a user or a chat."
msgstr ""
"Этот объект описывает фон, который можно использовать в качестве фона "
"темы экрана отправки ссылки на пользователя или чат."

#: litegram.types.chat_share_theme_backdrop.ChatShareThemeBackdrop:3 of
msgid "Source: https://core.telegram.org/bots/api#chatsharethemebackdrop"
msgstr "Источник: https://core.telegram.org/bots/api#chatsharethemebackdrop"

#: litegram.types.chat_share_theme_backdrop.ChatShareThemeBackdrop.id:1 of
msgid "Unique identifier of the backdrop"
msgstr "Уникальный идентификатор фона"

#: litegram.types.chat_share_theme_backdrop.ChatShareThemeBackdrop.name:1 of
msgid "Name of the backdrop"
msgstr "Название фона"

#: litegram.types.chat_share_theme_backdrop.ChatShareThemeBackdrop.colors:1 of
msgid "Colors of the backdrop"
msgstr "Цвета фона"

