#: ../../api/types/rich_block_list_item.rst:3
msgid "RichBlockListItem"
msgstr "RichBlockListItem"

#: litegram.types.rich_block_list_item.RichBlockListItem:1 of
msgid "An item of a list."
msgstr "Элемент списка."

#: litegram.types.rich_block_list_item.RichBlockListItem:3 of
msgid "Source: https://core.telegram.org/bots/api#richblocklistitem"
msgstr "Источник: https://core.telegram.org/bots/api#richblocklistitem"

#: litegram.types.rich_block_list_item.RichBlockListItem.label:1 of
msgid "Label of the item"
msgstr "Метка элемента"

#: litegram.types.rich_block_list_item.RichBlockListItem.blocks:1 of
msgid "The content of the item"
msgstr "Содержимое элемента"

#: litegram.types.rich_block_list_item.RichBlockListItem.has_checkbox:1 of
msgid "*Optional*. :code:`True`, if the item has a checkbox"
msgstr "*Необязательно*. :code:`True`, если у элемента есть флажок"

#: litegram.types.rich_block_list_item.RichBlockListItem.is_checked:1 of
msgid "*Optional*. :code:`True`, if the item has a checked checkbox"
msgstr "*Необязательно*. :code:`True`, если флажок элемента установлен"

#: litegram.types.rich_block_list_item.RichBlockListItem.value:1 of
msgid "*Optional*. For ordered lists, the numeric value of the item label"
msgstr ""
"*Необязательно*. Для упорядоченных списков — числовое значение метки "
"элемента"

#: litegram.types.rich_block_list_item.RichBlockListItem.type:1 of
msgid ""
"*Optional*. For ordered lists, the type of the item label; must be one of"
" 'a' for lowercase letters, 'A' for uppercase letters, 'i' for lowercase "
"Roman numerals, 'I' for uppercase Roman numerals, or '1' for decimal "
"numbers"
msgstr ""
"*Необязательно*. Для упорядоченных списков — тип метки элемента; "
"допустимые значения: 'a' (строчные буквы), 'A' (прописные буквы), 'i' "
"(строчные римские цифры), 'I' (прописные римские цифры) или '1' "
"(десятичные числа)"

