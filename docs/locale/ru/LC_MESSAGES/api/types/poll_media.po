#: ../../api/types/poll_media.rst:3
msgid "PollMedia"
msgstr "PollMedia"

#: litegram.types.poll_media.PollMedia:1 of
msgid "At most **one** of the optional fields can be present in any given object."
msgstr ""
"В объекте может присутствовать не более **одного** из необязательных "
"полей."

#: litegram.types.poll_media.PollMedia:3 of
msgid "Source: https://core.telegram.org/bots/api#pollmedia"
msgstr "Источник: https://core.telegram.org/bots/api#pollmedia"

#: litegram.types.poll_media.PollMedia.animation:1 of
msgid "*Optional*. Media is an animation, information about the animation"
msgstr "*Необязательно*. Медиа — анимация, информация об анимации"

#: litegram.types.poll_media.PollMedia.audio:1 of
msgid ""
"*Optional*. Media is an audio file, information about the file; "
"currently, can't be received in a poll option"
msgstr ""
"*Необязательно*. Медиа — аудиофайл, информация о файле; сейчас в "
"вариантах ответа опроса не встречается"

#: litegram.types.poll_media.PollMedia.document:1 of
msgid ""
"*Optional*. Media is a general file, information about the file; "
"currently, can't be received in a poll option"
msgstr ""
"*Необязательно*. Медиа — произвольный файл, информация о файле; сейчас в "
"вариантах ответа опроса не встречается"

#: litegram.types.poll_media.PollMedia.link:1 of
msgid "*Optional*. The HTTP link attached to the poll option"
msgstr "*Необязательно*. HTTP-ссылка, прикреплённая к варианту ответа"

#: litegram.types.poll_media.PollMedia.live_photo:1 of
msgid "*Optional*. Media is a live photo, information about the live photo"
msgstr "*Необязательно*. Медиа — живое фото, информация о живом фото"

#: litegram.types.poll_media.PollMedia.location:1 of
msgid "*Optional*. Media is a shared location, information about the location"
msgstr "*Необязательно*. Медиа — общая геолокация, информация о геолокации"

#: litegram.types.poll_media.PollMedia.photo:1 of
msgid "*Optional*. Media is a photo, available sizes of the photo"
msgstr "*Необязательно*. Медиа — фотография; доступные размеры фотографии"

#: litegram.types.poll_media.PollMedia.sticker:1 of
msgid ""
"*Optional*. Media is a sticker, information about the sticker; currently,"
" for poll options only"
msgstr ""
"*Необязательно*. Медиа — стикер, информация о стикере; сейчас только для "
"вариантов ответа опроса"

#: litegram.types.poll_media.PollMedia.venue:1 of
msgid "*Optional*. Media is a venue, information about the venue"
msgstr "*Необязательно*. Медиа — место, информация о месте"

#: litegram.types.poll_media.PollMedia.video:1 of
msgid "*Optional*. Media is a video, information about the video"
msgstr "*Необязательно*. Медиа — видео, информация о видео"

