#: ../../api/types/bot_command.rst:3
msgid "BotCommand"
msgstr "BotCommand"

#: litegram.types.bot_command.BotCommand:1 of
msgid "This object represents a bot command."
msgstr "Этот объект представляет команду бота."

#: litegram.types.bot_command.BotCommand:3 of
msgid "Source: https://core.telegram.org/bots/api#botcommand"
msgstr "Источник: https://core.telegram.org/bots/api#botcommand"

#: litegram.types.bot_command.BotCommand.command:1 of
msgid ""
"Text of the command; 1-32 characters. Can contain only lowercase English "
"letters, digits and underscores."
msgstr ""
"Текст команды; 1-32 символа. Может содержать только строчные английские "
"буквы, цифры и подчёркивания."

#: litegram.types.bot_command.BotCommand.description:1 of
msgid "Description of the command; 1-256 characters"
msgstr "Описание команды; от 1 до 256 символов"

#: litegram.types.bot_command.BotCommand.is_ephemeral:1 of
msgid ""
"*Optional*. :code:`True`, if the command sends an ephemeral message, which "
"can be seen only by the sender of the message and the bot"
msgstr ""
"*Необязательно*. :code:`True`, если команда отправляет эфемерное сообщение, "
"которое видят только его отправитель и бот"

#~ msgid "Description of the command; 1-256 characters."
#~ msgstr ""
