#: ../../api/types/input_rich_block_audio.rst:3
msgid "InputRichBlockAudio"
msgstr "InputRichBlockAudio"

#: litegram.types.input_rich_block_audio.InputRichBlockAudio:1 of
msgid "A block with a music file, corresponding to the HTML tag :code:`<audio>`."
msgstr "Блок с аудиофайлом; соответствует HTML-тегу :code:`<audio>`."

#: litegram.types.input_rich_block_audio.InputRichBlockAudio:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockaudio"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockaudio"

#: litegram.types.input_rich_block_audio.InputRichBlockAudio.type:1 of
msgid "Type of the block, always 'audio'"
msgstr "Тип блока, всегда 'audio'"

#: litegram.types.input_rich_block_audio.InputRichBlockAudio.audio:1 of
msgid "The audio. Caption is ignored."
msgstr "Аудио. Подпись игнорируется."

#: litegram.types.input_rich_block_audio.InputRichBlockAudio.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

