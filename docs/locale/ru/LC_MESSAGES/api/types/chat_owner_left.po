#: ../../api/types/chat_owner_left.rst:3
msgid "ChatOwnerLeft"
msgstr "ChatOwnerLeft"

#: litegram.types.chat_owner_left.ChatOwnerLeft:1 of
msgid "Describes a service message about the chat owner leaving the chat."
msgstr "Описывает сервисное сообщение о выходе владельца из чата."

#: litegram.types.chat_owner_left.ChatOwnerLeft:3 of
msgid "Source: https://core.telegram.org/bots/api#chatownerleft"
msgstr "Источник: https://core.telegram.org/bots/api#chatownerleft"

#: litegram.types.chat_owner_left.ChatOwnerLeft.new_owner:1 of
msgid ""
"*Optional*. The user who will become the new owner of the chat if the "
"previous owner does not return to the chat"
msgstr ""
"*Необязательно*. Пользователь, который станет новым владельцем чата, если"
" прежний владелец не вернётся в чат"

