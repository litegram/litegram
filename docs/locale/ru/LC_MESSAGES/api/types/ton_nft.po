#: ../../api/types/ton_nft.rst:3
msgid "TonNft"
msgstr "TonNft"

#: litegram.types.ton_nft.TonNft:1 of
msgid "This object represents an NFT in the TON blockchain."
msgstr "Этот объект представляет NFT в блокчейне TON."

#: litegram.types.ton_nft.TonNft:3 of
msgid "Source: https://core.telegram.org/bots/api#tonnft"
msgstr "Источник: https://core.telegram.org/bots/api#tonnft"

#: litegram.types.ton_nft.TonNft.address:1 of
msgid "Address of the NFT"
msgstr "Адрес NFT"

#: litegram.types.ton_nft.TonNft.collection_address:1 of
msgid ""
"*Optional*. Address of the collection to which the NFT belongs; omitted "
"if unknown"
msgstr ""
"*Необязательно*. Адрес коллекции, к которой принадлежит NFT; отсутствует,"
" если неизвестен"

#: litegram.types.ton_nft.TonNft.index:1 of
msgid "Index of the NFT among all NFTs from the collection as a decimal number"
msgstr "Номер NFT среди всех NFT коллекции в виде десятичного числа"

#: litegram.types.ton_nft.TonNft.name:1 of
msgid "Name of the NFT"
msgstr "Имя NFT"

#: litegram.types.ton_nft.TonNft.description:1 of
msgid "Description of the NFT"
msgstr "Описание NFT"

#: litegram.types.ton_nft.TonNft.attributes:1 of
msgid "*Optional*. Attributes of the NFT"
msgstr "*Необязательно*. Атрибуты NFT"

#: litegram.types.ton_nft.TonNft.gift:1 of
msgid "*Optional*. The unique gift corresponding to the NFT"
msgstr "*Необязательно*. Уникальный подарок, соответствующий NFT"

