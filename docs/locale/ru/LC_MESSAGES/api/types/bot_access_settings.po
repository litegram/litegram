#: ../../api/types/bot_access_settings.rst:3
msgid "BotAccessSettings"
msgstr "BotAccessSettings"

#: litegram.types.bot_access_settings.BotAccessSettings:1 of
msgid "This object describes the access settings of a bot."
msgstr "Этот объект описывает настройки доступа к боту."

#: litegram.types.bot_access_settings.BotAccessSettings:3 of
msgid "Source: https://core.telegram.org/bots/api#botaccesssettings"
msgstr "Источник: https://core.telegram.org/bots/api#botaccesssettings"

#: litegram.types.bot_access_settings.BotAccessSettings.is_access_restricted:1
#: of
msgid ""
":code:`True`, if only selected users can access the bot. The bot's owner "
"can always access it."
msgstr ""
":code:`True`, если доступ к боту есть только у выбранных пользователей. "
"Владелец бота всегда имеет к нему доступ."

#: litegram.types.bot_access_settings.BotAccessSettings.added_users:1 of
msgid ""
"*Optional*. The list of other users who have access to the bot if the "
"access is restricted"
msgstr ""
"*Необязательно*. Список других пользователей, имеющих доступ к боту, если"
" доступ ограничен"

