#: ../../api/types/input_media_location.rst:3
msgid "InputMediaLocation"
msgstr "InputMediaLocation"

#: litegram.types.input_media_location.InputMediaLocation:1 of
msgid "Represents a location to be sent."
msgstr "Представляет отправляемую геолокацию."

#: litegram.types.input_media_location.InputMediaLocation:3 of
msgid "Source: https://core.telegram.org/bots/api#inputmedialocation"
msgstr "Источник: https://core.telegram.org/bots/api#inputmedialocation"

#: litegram.types.input_media_location.InputMediaLocation.type:1 of
msgid "Type of the media, must be *location*"
msgstr "Тип медиа, должен быть *location*"

#: litegram.types.input_media_location.InputMediaLocation.latitude:1 of
msgid "Latitude of the location"
msgstr "Широта геолокации"

#: litegram.types.input_media_location.InputMediaLocation.longitude:1 of
msgid "Longitude of the location"
msgstr "Долгота геолокации"

#: litegram.types.input_media_location.InputMediaLocation.horizontal_accuracy:1
#: of
msgid ""
"*Optional*. The radius of uncertainty for the location, measured in "
"meters; 0-1500"
msgstr "*Необязательно*. Радиус неопределённости геолокации в метрах; от 0 до 1500"

