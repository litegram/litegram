#: ../../api/types/input_media_venue.rst:3
msgid "InputMediaVenue"
msgstr "InputMediaVenue"

#: litegram.types.input_media_venue.InputMediaVenue:1 of
msgid "Represents a venue to be sent."
msgstr "Представляет отправляемое место."

#: litegram.types.input_media_venue.InputMediaVenue:3 of
msgid "Source: https://core.telegram.org/bots/api#inputmediavenue"
msgstr "Источник: https://core.telegram.org/bots/api#inputmediavenue"

#: litegram.types.input_media_venue.InputMediaVenue.type:1 of
msgid "Type of the media, must be *venue*"
msgstr "Тип медиа, должен быть *venue*"

#: litegram.types.input_media_venue.InputMediaVenue.latitude:1 of
msgid "Latitude of the location"
msgstr "Широта геолокации"

#: litegram.types.input_media_venue.InputMediaVenue.longitude:1 of
msgid "Longitude of the location"
msgstr "Долгота геолокации"

#: litegram.types.input_media_venue.InputMediaVenue.title:1 of
msgid "Name of the venue"
msgstr "Название места"

#: litegram.types.input_media_venue.InputMediaVenue.address:1 of
msgid "Address of the venue"
msgstr "Адрес места"

#: litegram.types.input_media_venue.InputMediaVenue.foursquare_id:1 of
msgid "*Optional*. Foursquare identifier of the venue"
msgstr "*Необязательно*. Идентификатор места в Foursquare"

#: litegram.types.input_media_venue.InputMediaVenue.foursquare_type:1 of
msgid ""
"*Optional*. Foursquare type of the venue, if known. (For example, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' or "
"'food/icecream'.)"
msgstr ""
"*Необязательно*. Тип места в Foursquare, если известен (например, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' или "
"'food/icecream')."

#: litegram.types.input_media_venue.InputMediaVenue.google_place_id:1 of
msgid "*Optional*. Google Places identifier of the venue"
msgstr "*Необязательно*. Идентификатор места в Google Places"

#: litegram.types.input_media_venue.InputMediaVenue.google_place_type:1 of
msgid ""
"*Optional*. Google Places type of the venue. (See `supported types "
"<https://developers.google.com/places/web-service/supported_types>`_.)"
msgstr ""
"*Необязательно*. Тип места в Google Places. (См. `поддерживаемые типы "
"<https://developers.google.com/places/web-service/supported_types>`_.)"

