#: ../../api/types/bot_command_scope_chat_member.rst:3
msgid "BotCommandScopeChatMember"
msgstr "BotCommandScopeChatMember"

#: litegram.types.bot_command_scope_chat_member.BotCommandScopeChatMember:1 of
msgid ""
"Represents the `scope <https://core.telegram.org/bots/api#botcommandscope>`_ "
"of bot commands, covering a specific member of a group or supergroup chat."
msgstr ""
"Представляет `область действия "
"<https://core.telegram.org/bots/api#botcommandscope>`_ команд бота, "
"охватывающую конкретного участника группы или супергруппы."

#: litegram.types.bot_command_scope_chat_member.BotCommandScopeChatMember:3 of
msgid "Source: https://core.telegram.org/bots/api#botcommandscopechatmember"
msgstr "Источник: https://core.telegram.org/bots/api#botcommandscopechatmember"

#: litegram.types.bot_command_scope_chat_member.BotCommandScopeChatMember.type:1
#: of
msgid "Scope type, must be *chat_member*"
msgstr "Тип области действия, должно быть *chat_member*"

#: litegram.types.bot_command_scope_chat_member.BotCommandScopeChatMember.chat_id:1
#: of
msgid ""
"Unique identifier for the target chat or username of the target supergroup in"
" the format :code:`@username`. Channel direct messages chats and channel "
"chats aren't supported."
msgstr ""
"Уникальный идентификатор целевого чата или имя целевой супергруппы в формате "
":code:`@username`. Чаты личных сообщений канала и каналы не поддерживаются."

#: litegram.types.bot_command_scope_chat_member.BotCommandScopeChatMember.user_id:1
#: of
msgid "Unique identifier of the target user"
msgstr "Уникальный идентификатор целевого пользователя"

#~ msgid ""
#~ "Unique identifier for the target chat or username of the target supergroup "
#~ "(in the format :code:`@supergroupusername`). Channel direct messages chats "
#~ "and channel chats aren't supported."
#~ msgstr ""
