#: ../../api/types/rich_block_map.rst:3
msgid "RichBlockMap"
msgstr "RichBlockMap"

#: litegram.types.rich_block_map.RichBlockMap:1 of
msgid "A block with a map, corresponding to the custom HTML tag :code:`<tg-map>`."
msgstr "Блок с картой; соответствует пользовательскому HTML-тегу :code:`<tg-map>`."

#: litegram.types.rich_block_map.RichBlockMap:3 of
msgid "Source: https://core.telegram.org/bots/api#richblockmap"
msgstr "Источник: https://core.telegram.org/bots/api#richblockmap"

#: litegram.types.rich_block_map.RichBlockMap.type:1 of
msgid "Type of the block, always 'map'"
msgstr "Тип блока, всегда 'map'"

#: litegram.types.rich_block_map.RichBlockMap.location:1 of
msgid "Location of the center of the map"
msgstr "Геолокация центра карты"

#: litegram.types.rich_block_map.RichBlockMap.zoom:1 of
msgid "Map zoom level"
msgstr "Уровень масштабирования карты"

#: litegram.types.rich_block_map.RichBlockMap.width:1 of
msgid "Expected width of the map"
msgstr "Ожидаемая ширина карты"

#: litegram.types.rich_block_map.RichBlockMap.height:1 of
msgid "Expected height of the map"
msgstr "Ожидаемая высота карты"

#: litegram.types.rich_block_map.RichBlockMap.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

