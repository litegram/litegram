#: litegram.types.inaccessible_message.InaccessibleMessage.reply_sticker:23 of
msgid "instance of method :class:`litegram.methods.send_sticker.SendSticker`"
msgstr "экземпляр метода :class:`litegram.methods.send_sticker.SendSticker`"

