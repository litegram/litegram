#: litegram.types.inaccessible_message.InaccessibleMessage.reply_animation:17
#: of
msgid "Animation height"
msgstr "Высота анимации"

#: litegram.types.inaccessible_message.InaccessibleMessage.answer_animation:17
#: litegram.types.inaccessible_message.InaccessibleMessage.answer_audio:21
#: litegram.types.inaccessible_message.InaccessibleMessage.answer_document:14
