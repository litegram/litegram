msgstr "Долгота местоположения"

#: litegram.types.inaccessible_message.InaccessibleMessage.answer_location:15
#: litegram.types.inaccessible_message.InaccessibleMessage.reply_location:16 of
msgid "The radius of uncertainty for the location, measured in meters; 0-1500"
msgstr "Радиус неточности местоположения в метрах; 0-1500"

