#: ../../api/types/input_rich_block_animation.rst:3
msgid "InputRichBlockAnimation"
msgstr "InputRichBlockAnimation"

#: litegram.types.input_rich_block_animation.InputRichBlockAnimation:1 of
msgid "A block with an animation, corresponding to the HTML tag :code:`<video>`."
msgstr "Блок с анимацией; соответствует HTML-тегу :code:`<video>`."

#: litegram.types.input_rich_block_animation.InputRichBlockAnimation:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockanimation"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockanimation"

#: litegram.types.input_rich_block_animation.InputRichBlockAnimation.type:1 of
msgid "Type of the block, always 'animation'"
msgstr "Тип блока, всегда 'animation'"

#: litegram.types.input_rich_block_animation.InputRichBlockAnimation.animation:1
#: of
msgid "The animation. Caption is ignored."
msgstr "Анимация. Подпись игнорируется."

#: litegram.types.input_rich_block_animation.InputRichBlockAnimation.caption:1
#: of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

