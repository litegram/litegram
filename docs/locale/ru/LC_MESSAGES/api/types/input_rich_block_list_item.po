#: ../../api/types/input_rich_block_list_item.rst:3
msgid "InputRichBlockListItem"
msgstr "InputRichBlockListItem"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem:1 of
msgid "An item of a list to be sent."
msgstr "Элемент отправляемого списка."

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblocklistitem"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblocklistitem"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem.blocks:1 of
msgid "The content of the item"
msgstr "Содержимое элемента"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem.has_checkbox:1
#: of
msgid "*Optional*. Pass :code:`True` if the item has a checkbox"
msgstr ""
"*Необязательно*. Передайте :code:`True`, если у элемента должен быть "
"флажок"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem.is_checked:1
#: of
msgid "*Optional*. Pass :code:`True` if the item has a checked checkbox"
msgstr ""
"*Необязательно*. Передайте :code:`True`, если флажок элемента должен быть"
" установлен"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem.value:1 of
msgid "*Optional*. For ordered lists, the numeric value of the item label"
msgstr ""
"*Необязательно*. Для упорядоченных списков — числовое значение метки "
"элемента"

#: litegram.types.input_rich_block_list_item.InputRichBlockListItem.type:1 of
msgid ""
"*Optional*. For ordered lists, the type of the item label; must be one of"
" 'a' for lowercase letters, 'A' for uppercase letters, 'i' for lowercase "
"Roman numerals, 'I' for uppercase Roman numerals, or '1' for decimal "
"numbers"
msgstr ""
"*Необязательно*. Для упорядоченных списков — тип метки элемента; "
"допустимые значения: 'a' (строчные буквы), 'A' (прописные буквы), 'i' "
"(строчные римские цифры), 'I' (прописные римские цифры) или '1' "
"(десятичные числа)"

