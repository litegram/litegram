#: ../../api/types/input_rich_block_anchor.rst:3
msgid "InputRichBlockAnchor"
msgstr "InputRichBlockAnchor"

#: litegram.types.input_rich_block_anchor.InputRichBlockAnchor:1 of
msgid ""
"A block with an anchor, corresponding to the HTML tag :code:`<a>` with "
"the attribute :code:`name`."
msgstr ""
"Блок с якорем; соответствует HTML-тегу :code:`<a>` с атрибутом "
":code:`name`."

#: litegram.types.input_rich_block_anchor.InputRichBlockAnchor:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockanchor"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockanchor"

#: litegram.types.input_rich_block_anchor.InputRichBlockAnchor.type:1 of
msgid "Type of the block, always 'anchor'"
msgstr "Тип блока, всегда 'anchor'"

#: litegram.types.input_rich_block_anchor.InputRichBlockAnchor.name:1 of
msgid "The name of the anchor"
msgstr "Имя якоря"

