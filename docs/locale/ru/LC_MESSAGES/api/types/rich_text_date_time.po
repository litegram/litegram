#: ../../api/types/rich_text_date_time.rst:3
msgid "RichTextDateTime"
msgstr "RichTextDateTime"

#: litegram.types.rich_text_date_time.RichTextDateTime:1 of
msgid "Formatted date and time."
msgstr "Отформатированные дата и время."

#: litegram.types.rich_text_date_time.RichTextDateTime:3 of
msgid "Source: https://core.telegram.org/bots/api#richtextdatetime"
msgstr "Источник: https://core.telegram.org/bots/api#richtextdatetime"

#: litegram.types.rich_text_date_time.RichTextDateTime.type:1 of
msgid "Type of the rich text, always 'date_time'"
msgstr "Тип форматированного (rich) текста, всегда 'date_time'"

#: litegram.types.rich_text_date_time.RichTextDateTime.text:1 of
msgid "The text"
msgstr "Текст"

#: litegram.types.rich_text_date_time.RichTextDateTime.unix_time:1 of
msgid "The Unix time associated with the entity"
msgstr "Время Unix, связанное с сущностью"

#: litegram.types.rich_text_date_time.RichTextDateTime.date_time_format:1 of
msgid ""
"The string that defines the formatting of the date and time. See `date-"
"time entity formatting <https://core.telegram.org/bots/api#date-time-"
"entity-formatting>`_ for more details."
msgstr ""
"Строка, задающая формат даты и времени. Подробнее см. `форматирование "
"сущностей даты и времени <https://core.telegram.org/bots/api#date-time-"
"entity-formatting>`_."

