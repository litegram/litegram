#: ../../api/types/widget_query_type_sent_transaction.rst:3
msgid "WidgetQueryTypeSentTransaction"
msgstr "WidgetQueryTypeSentTransaction"

#: litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction:1
#: of
msgid ""
"The query notifies the bot about a transaction sent from a TON wallet of "
"the user who sent the query."
msgstr ""
"Запрос уведомляет бота о транзакции, отправленной с TON-кошелька "
"пользователя, отправившего запрос."

#: litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction:3
#: of
msgid "Source: https://core.telegram.org/bots/api#widgetquerytypesenttransaction"
msgstr ""
"Источник: "
"https://core.telegram.org/bots/api#widgetquerytypesenttransaction"

#: litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction.type:1
#: of
msgid "Type of the query, always 'sent_transaction'"
msgstr "Тип запроса, всегда 'sent_transaction'"

#: litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction.wallet:1
#: of
msgid "The wallet from which the transaction was sent"
msgstr "Кошелёк, с которого отправлена транзакция"

#: litegram.types.widget_query_type_sent_transaction.WidgetQueryTypeSentTransaction.msg_hash:1
#: of
msgid "Value of *msg_hash* of the transaction"
msgstr "Значение *msg_hash* транзакции"

