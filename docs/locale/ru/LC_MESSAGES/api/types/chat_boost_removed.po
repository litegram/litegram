#: ../../api/types/chat_boost_removed.rst:3
msgid "ChatBoostRemoved"
msgstr "ChatBoostRemoved"

#: litegram.types.chat_boost_removed.ChatBoostRemoved:1 of
msgid "This object represents a boost removed from a chat."
msgstr "Этот объект представляет буст, удалённый из чата."

#: litegram.types.chat_boost_removed.ChatBoostRemoved:3 of
msgid "Source: https://core.telegram.org/bots/api#chatboostremoved"
msgstr "Источник: https://core.telegram.org/bots/api#chatboostremoved"

#: ../../docstring litegram.types.chat_boost_removed.ChatBoostRemoved.chat:1 of
msgid "Chat which was boosted"
msgstr "Чат, который был забуштен"

#: ../../docstring
#: litegram.types.chat_boost_removed.ChatBoostRemoved.boost_id:1 of
msgid "Unique identifier of the boost"
msgstr "Уникальный идентификатор буста"

#: ../../docstring
#: litegram.types.chat_boost_removed.ChatBoostRemoved.remove_date:1 of
msgid "Point in time (Unix timestamp) when the boost was removed"
msgstr "Момент времени (Unix timestamp), когда буст был удалён"

#: ../../docstring litegram.types.chat_boost_removed.ChatBoostRemoved.source:1
#: of
msgid "Source of the removed boost"
msgstr "Источник удалённого буста"
