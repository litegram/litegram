#: ../../api/types/input_rich_block_photo.rst:3
msgid "InputRichBlockPhoto"
msgstr "InputRichBlockPhoto"

#: litegram.types.input_rich_block_photo.InputRichBlockPhoto:1 of
msgid "A block with a photo, corresponding to the HTML tag :code:`<img>`."
msgstr "Блок с фотографией; соответствует HTML-тегу :code:`<img>`."

#: litegram.types.input_rich_block_photo.InputRichBlockPhoto:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockphoto"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockphoto"

#: litegram.types.input_rich_block_photo.InputRichBlockPhoto.type:1 of
msgid "Type of the block, always 'photo'"
msgstr "Тип блока, всегда 'photo'"

#: litegram.types.input_rich_block_photo.InputRichBlockPhoto.photo:1 of
msgid "The photo. Caption is ignored."
msgstr "Фотография. Подпись игнорируется."

#: litegram.types.input_rich_block_photo.InputRichBlockPhoto.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

