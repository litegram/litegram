#: ../../api/types/background_type_wallpaper.rst:3
msgid "BackgroundTypeWallpaper"
msgstr "BackgroundTypeWallpaper"

#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper:1 of
msgid "The background is a wallpaper in the JPEG format."
msgstr "Фон — обои в формате JPEG."

#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper:3 of
msgid "Source: https://core.telegram.org/bots/api#backgroundtypewallpaper"
msgstr "Источник: https://core.telegram.org/bots/api#backgroundtypewallpaper"

#: ../../docstring
#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper.type:1 of
msgid "Type of the background, always 'wallpaper'"
msgstr "Тип фона, всегда 'wallpaper'"

#: ../../docstring
#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper.document:1
#: of
msgid "Document with the wallpaper"
msgstr "Документ с обоями"

#: ../../docstring
#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper.dark_theme_dimming:1
#: of
msgid "Dimming of the background in dark themes, as a percentage; 0-100"
msgstr "Затемнение фона в тёмных темах, в процентах; 0-100"

#: ../../docstring
#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper.is_blurred:1
#: of
msgid ""
"*Optional*. :code:`True`, if the wallpaper is downscaled to fit in a 450x450 "
"square and then box-blurred with radius 12"
msgstr ""
"*Необязательно*. :code:`True`, если обои уменьшаются до размера квадрата "
"450x450, после чего применяется box-размытие с радиусом 12"

#: ../../docstring
#: litegram.types.background_type_wallpaper.BackgroundTypeWallpaper.is_moving:1
#: of
msgid ""
"*Optional*. :code:`True`, if the background moves slightly when the device is"
" tilted"
msgstr ""
"*Необязательно*. :code:`True`, если фон слегка смещается при наклоне "
"устройства"
