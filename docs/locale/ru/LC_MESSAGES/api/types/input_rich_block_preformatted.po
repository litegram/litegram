#: ../../api/types/input_rich_block_preformatted.rst:3
msgid "InputRichBlockPreformatted"
msgstr "InputRichBlockPreformatted"

#: litegram.types.input_rich_block_preformatted.InputRichBlockPreformatted:1 of
msgid ""
"A preformatted text block, corresponding to the nested HTML tags "
":code:`<pre>` and :code:`<code>`."
msgstr ""
"Блок предварительно отформатированного текста; соответствует вложенным "
"HTML-тегам :code:`<pre>` и :code:`<code>`."

#: litegram.types.input_rich_block_preformatted.InputRichBlockPreformatted:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockpreformatted"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockpreformatted"

#: litegram.types.input_rich_block_preformatted.InputRichBlockPreformatted.type:1
#: of
msgid "Type of the block, always 'pre'"
msgstr "Тип блока, всегда 'pre'"

#: litegram.types.input_rich_block_preformatted.InputRichBlockPreformatted.text:1
#: of
msgid "Text of the block"
msgstr "Текст блока"

#: litegram.types.input_rich_block_preformatted.InputRichBlockPreformatted.language:1
#: of
msgid "*Optional*. The programming language of the text"
msgstr "*Необязательно*. Язык программирования текста"

