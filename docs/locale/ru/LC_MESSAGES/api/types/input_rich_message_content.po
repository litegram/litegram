#: ../../api/types/input_rich_message_content.rst:3
msgid "InputRichMessageContent"
msgstr "InputRichMessageContent"

#: litegram.types.input_rich_message_content.InputRichMessageContent:1 of
msgid ""
"Represents the `content "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ of a rich "
"message to be sent as the result of an inline query."
msgstr ""
"Представляет `содержимое "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ "
"форматированного (rich) сообщения, отправляемого как результат "
"inline-запроса."

#: litegram.types.input_rich_message_content.InputRichMessageContent:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichmessagecontent"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichmessagecontent"

#: litegram.types.input_rich_message_content.InputRichMessageContent.rich_message:1
#: of
msgid ""
"The message to be sent. Only previously uploaded files may be used in the"
" message."
msgstr ""
"Отправляемое сообщение. В нём можно использовать только ранее загруженные"
" файлы."

