#: ../../docstring litegram.types.reaction_count.ReactionCount.type:1 of
msgid "Type of the reaction"
msgstr "Тип реакции"

#: ../../docstring litegram.types.reaction_count.ReactionCount.total_count:1 of
msgid "Number of times the reaction was added"
msgstr "Сколько раз реакция была добавлена"
