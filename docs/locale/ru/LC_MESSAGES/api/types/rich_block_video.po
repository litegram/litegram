#: ../../api/types/rich_block_video.rst:3
msgid "RichBlockVideo"
msgstr "RichBlockVideo"

#: litegram.types.rich_block_video.RichBlockVideo:1 of
msgid "A block with a video, corresponding to the HTML tag :code:`<video>`."
msgstr "Блок с видео; соответствует HTML-тегу :code:`<video>`."

#: litegram.types.rich_block_video.RichBlockVideo:3 of
msgid "Source: https://core.telegram.org/bots/api#richblockvideo"
msgstr "Источник: https://core.telegram.org/bots/api#richblockvideo"

#: litegram.types.rich_block_video.RichBlockVideo.type:1 of
msgid "Type of the block, always 'video'"
msgstr "Тип блока, всегда 'video'"

#: litegram.types.rich_block_video.RichBlockVideo.video:1 of
msgid "The video"
msgstr "Видео"

#: litegram.types.rich_block_video.RichBlockVideo.has_spoiler:1 of
msgid ""
"*Optional*. :code:`True`, if the media preview is covered by a spoiler "
"animation"
msgstr "*Необязательно*. :code:`True`, если медиа скрыто под анимацией спойлера"

#: litegram.types.rich_block_video.RichBlockVideo.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

