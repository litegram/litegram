#: ../../api/types/rich_block_table_cell.rst:3
msgid "RichBlockTableCell"
msgstr "RichBlockTableCell"

#: litegram.types.rich_block_table_cell.RichBlockTableCell:1 of
msgid "Cell in a table."
msgstr "Ячейка таблицы."

#: litegram.types.rich_block_table_cell.RichBlockTableCell:3 of
msgid "Source: https://core.telegram.org/bots/api#richblocktablecell"
msgstr "Источник: https://core.telegram.org/bots/api#richblocktablecell"

#: litegram.types.rich_block_table_cell.RichBlockTableCell.text:1 of
msgid "*Optional*. Text in the cell. If omitted, then the cell is invisible."
msgstr "*Необязательно*. Текст в ячейке. Если не задан, ячейка невидима."

#: litegram.types.rich_block_table_cell.RichBlockTableCell.is_header:1 of
msgid "*Optional*. :code:`True`, if the cell is a header cell"
msgstr "*Необязательно*. :code:`True`, если ячейка является заголовочной"

#: litegram.types.rich_block_table_cell.RichBlockTableCell.colspan:1 of
msgid "*Optional*. The number of columns the cell spans if it is bigger than 1"
msgstr ""
"*Необязательно*. Количество столбцов, занимаемых ячейкой, если оно больше"
" 1"

#: litegram.types.rich_block_table_cell.RichBlockTableCell.rowspan:1 of
msgid "*Optional*. The number of rows the cell spans if it is bigger than 1"
msgstr "*Необязательно*. Количество строк, занимаемых ячейкой, если оно больше 1"

#: litegram.types.rich_block_table_cell.RichBlockTableCell.align:1 of
msgid ""
"Horizontal cell content alignment. Currently, must be one of 'left', "
"'center', or 'right'."
msgstr ""
"Горизонтальное выравнивание содержимого ячейки. Допустимые значения: "
"'left', 'center' или 'right'."

#: litegram.types.rich_block_table_cell.RichBlockTableCell.valign:1 of
msgid ""
"Vertical cell content alignment. Currently, must be one of 'top', "
"'middle', or 'bottom'."
msgstr ""
"Вертикальное выравнивание содержимого ячейки. Допустимые значения: 'top',"
" 'middle' или 'bottom'."

