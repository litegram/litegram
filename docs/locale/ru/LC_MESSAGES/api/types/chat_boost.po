#: ../../api/types/chat_boost.rst:3
msgid "ChatBoost"
msgstr "ChatBoost"

#: litegram.types.chat_boost.ChatBoost:1 of
msgid "This object contains information about a chat boost."
msgstr "Этот объект содержит информацию о бусте чата."

#: litegram.types.chat_boost.ChatBoost:3 of
msgid "Source: https://core.telegram.org/bots/api#chatboost"
msgstr "Источник: https://core.telegram.org/bots/api#chatboost"

#: ../../docstring litegram.types.chat_boost.ChatBoost.boost_id:1 of
msgid "Unique identifier of the boost"
msgstr "Уникальный идентификатор буста"

#: ../../docstring litegram.types.chat_boost.ChatBoost.add_date:1 of
msgid "Point in time (Unix timestamp) when the chat was boosted"
msgstr "Момент времени (Unix timestamp), когда чат был забуштен"

#: ../../docstring litegram.types.chat_boost.ChatBoost.expiration_date:1 of
msgid ""
"Point in time (Unix timestamp) when the boost will automatically expire, "
"unless the booster's Telegram Premium subscription is prolonged"
msgstr ""
"Момент времени (Unix timestamp), когда буст автоматически истечёт, если "
"подписка Telegram Premium бустера не будет продлена"

#: ../../docstring litegram.types.chat_boost.ChatBoost.source:1 of
msgid "Source of the added boost"
msgstr "Источник добавленного буста"
