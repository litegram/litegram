#: ../../api/types/input_venue_message_content.rst:3
msgid "InputVenueMessageContent"
msgstr "InputVenueMessageContent"

#: litegram.types.input_venue_message_content.InputVenueMessageContent:1 of
msgid ""
"Represents the `content "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ of a venue message"
" to be sent as the result of an inline query."
msgstr ""
"Представляет `содержимое "
"<https://core.telegram.org/bots/api#inputmessagecontent>`_ сообщения с "
"местом, которое будет отправлено как результат inline-запроса."

#: litegram.types.input_venue_message_content.InputVenueMessageContent:3 of
msgid "Source: https://core.telegram.org/bots/api#inputvenuemessagecontent"
msgstr "Источник: https://core.telegram.org/bots/api#inputvenuemessagecontent"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.latitude:1
#: of
msgid "Latitude of the venue in degrees"
msgstr "Широта места в градусах"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.longitude:1
#: of
msgid "Longitude of the venue in degrees"
msgstr "Долгота места в градусах"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.title:1
#: of
msgid "Name of the venue"
msgstr "Название места"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.address:1
#: of
msgid "Address of the venue"
msgstr "Адрес места"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.foursquare_id:1
#: of
msgid "*Optional*. Foursquare identifier of the venue, if known"
msgstr "*Необязательно*. Идентификатор места в Foursquare, если известен"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.foursquare_type:1
#: of
msgid ""
"*Optional*. Foursquare type of the venue, if known. (For example, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' or "
"'food/icecream'.)"
msgstr ""
"*Необязательно*. Тип места в Foursquare, если известен (например, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' или "
"'food/icecream')."

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.google_place_id:1
#: of
msgid "*Optional*. Google Places identifier of the venue"
msgstr "*Необязательно*. Идентификатор места в Google Places"

#: ../../docstring
#: litegram.types.input_venue_message_content.InputVenueMessageContent.google_place_type:1
#: of
msgid ""
"*Optional*. Google Places type of the venue. (See `supported types "
"<https://developers.google.com/places/web-service/supported_types>`_.)"
msgstr ""
"*Необязательно*. Тип места в Google Places (см. `поддерживаемые типы "
"<https://developers.google.com/places/web-service/supported_types>`_)."
