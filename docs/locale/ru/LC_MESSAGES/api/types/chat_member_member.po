#: ../../api/types/chat_member_member.rst:3
msgid "ChatMemberMember"
msgstr "ChatMemberMember"

#: litegram.types.chat_member_member.ChatMemberMember:1 of
msgid ""
"Represents a `chat member <https://core.telegram.org/bots/api#chatmember>`_ "
"that has no additional privileges or restrictions."
msgstr ""
"Представляет `участника чата "
"<https://core.telegram.org/bots/api#chatmember>`_ без дополнительных прав или"
" ограничений."

#: litegram.types.chat_member_member.ChatMemberMember:3 of
msgid "Source: https://core.telegram.org/bots/api#chatmembermember"
msgstr "Источник: https://core.telegram.org/bots/api#chatmembermember"

#: litegram.types.chat_member_member.ChatMemberMember.status:1 of
msgid "The member's status in the chat, always 'member'"
msgstr "Статус участника в чате, всегда 'member'"

#: litegram.types.chat_member_member.ChatMemberMember.tag:1 of
msgid "*Optional*. Tag of the member"
msgstr "*Необязательно*. Тег участника"

#: litegram.types.chat_member_member.ChatMemberMember.user:1 of
msgid "Information about the user"
msgstr "Информация о пользователе"

#: litegram.types.chat_member_member.ChatMemberMember.until_date:1 of
msgid "*Optional*. Date when the user's subscription will expire; Unix time"
msgstr "*Необязательно*. Дата окончания подписки пользователя; Unix time"
