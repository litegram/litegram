#: ../../api/types/input_rich_block_voice_note.rst:3
msgid "InputRichBlockVoiceNote"
msgstr "InputRichBlockVoiceNote"

#: litegram.types.input_rich_block_voice_note.InputRichBlockVoiceNote:1 of
msgid "A block with a voice note, corresponding to the HTML tag :code:`<audio>`."
msgstr "Блок с голосовым сообщением; соответствует HTML-тегу :code:`<audio>`."

#: litegram.types.input_rich_block_voice_note.InputRichBlockVoiceNote:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockvoicenote"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockvoicenote"

#: litegram.types.input_rich_block_voice_note.InputRichBlockVoiceNote.type:1 of
msgid "Type of the block, always 'voice_note'"
msgstr "Тип блока, всегда 'voice_note'"

#: litegram.types.input_rich_block_voice_note.InputRichBlockVoiceNote.voice_note:1
#: of
msgid "The voice note. Caption is ignored."
msgstr "Голосовое сообщение. Подпись игнорируется."

#: litegram.types.input_rich_block_voice_note.InputRichBlockVoiceNote.caption:1
#: of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

