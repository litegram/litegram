#: ../../api/types/input_rich_block_details.rst:3
msgid "InputRichBlockDetails"
msgstr "InputRichBlockDetails"

#: litegram.types.input_rich_block_details.InputRichBlockDetails:1 of
msgid ""
"An expandable block for details disclosure, corresponding to the HTML tag"
" :code:`<details>`."
msgstr ""
"Блок подробностей со сворачиванием; соответствует HTML-тегу "
":code:`<details>`."

#: litegram.types.input_rich_block_details.InputRichBlockDetails:3 of
msgid "Source: https://core.telegram.org/bots/api#inputrichblockdetails"
msgstr "Источник: https://core.telegram.org/bots/api#inputrichblockdetails"

#: litegram.types.input_rich_block_details.InputRichBlockDetails.type:1 of
msgid "Type of the block, always 'details'"
msgstr "Тип блока, всегда 'details'"

#: litegram.types.input_rich_block_details.InputRichBlockDetails.summary:1 of
msgid "Always shown summary of the block"
msgstr "Всегда отображаемая сводка блока"

#: litegram.types.input_rich_block_details.InputRichBlockDetails.blocks:1 of
msgid "Content of the block"
msgstr "Содержимое блока"

#: litegram.types.input_rich_block_details.InputRichBlockDetails.is_open:1 of
msgid ""
"*Optional*. Pass :code:`True` if the content of the block is visible by "
"default"
msgstr ""
"*Необязательно*. Передайте :code:`True`, если содержимое блока по "
"умолчанию раскрыто"

