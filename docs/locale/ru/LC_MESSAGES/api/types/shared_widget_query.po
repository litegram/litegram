#: ../../api/types/shared_widget_query.rst:3
msgid "SharedWidgetQuery"
msgstr "SharedWidgetQuery"

#: litegram.types.shared_widget_query.SharedWidgetQuery:1 of
msgid ""
"This object represents an incoming query from a forwarded message with a "
"shared widget created by the bot. Use "
":class:`litegram.methods.answer_widget_query.AnswerWidgetQuery` to answer"
" the query. Each user can send at most 5 queries per 5 seconds to the bot"
" from all its widgets."
msgstr ""
"Этот объект представляет входящий запрос из пересланного сообщения с "
"переиспользуемым виджетом, созданным ботом. Для ответа на запрос "
"используйте "
":class:`litegram.methods.answer_widget_query.AnswerWidgetQuery`. Каждый "
"пользователь может отправить боту не более 5 запросов за 5 секунд со всех"
" его виджетов."

#: litegram.types.shared_widget_query.SharedWidgetQuery:3 of
msgid "Source: https://core.telegram.org/bots/api#sharedwidgetquery"
msgstr "Источник: https://core.telegram.org/bots/api#sharedwidgetquery"

#: litegram.types.shared_widget_query.SharedWidgetQuery.id:1 of
msgid "Unique identifier for this query"
msgstr "Уникальный идентификатор этого запроса"

#: litegram.types.shared_widget_query.SharedWidgetQuery.from_user:1 of
msgid "Sender"
msgstr "Sender"

#: litegram.types.shared_widget_query.SharedWidgetQuery.type:1 of
msgid "Type of the query"
msgstr "Тип запроса"

#: litegram.types.shared_widget_query.SharedWidgetQuery.data:1 of
msgid "Data of the query, 1-64 bytes"
msgstr "Данные запроса, от 1 до 64 байт"

#: litegram.types.shared_widget_query.SharedWidgetQuery.widget_id:1 of
msgid "Unique identifier of the shared widget, which sent the query"
msgstr "Уникальный идентификатор переиспользуемого виджета, отправившего запрос"

