#: ../../api/types/venue.rst:3
msgid "Venue"
msgstr "Venue"

#: litegram.types.venue.Venue:1 of
msgid "This object represents a venue."
msgstr "Этот объект представляет место."

#: litegram.types.venue.Venue:3 of
msgid "Source: https://core.telegram.org/bots/api#venue"
msgstr "Источник: https://core.telegram.org/bots/api#venue"

#: litegram.types.venue.Venue.location:1 of
msgid "Venue location. Can't be a live location."
msgstr "Геолокация места. Не может быть live-локацией."

#: litegram.types.venue.Venue.title:1 of
msgid "Name of the venue"
msgstr "Название места"

#: litegram.types.venue.Venue.address:1 of
msgid "Address of the venue"
msgstr "Адрес места"

#: litegram.types.venue.Venue.foursquare_id:1 of
msgid "*Optional*. Foursquare identifier of the venue"
msgstr "*Необязательно*. Идентификатор места в Foursquare"

#: litegram.types.venue.Venue.foursquare_type:1 of
msgid ""
"*Optional*. Foursquare type of the venue. (For example, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' or "
"'food/icecream'.)"
msgstr ""
"*Необязательно*. Тип места в Foursquare (например, "
"'arts_entertainment/default', 'arts_entertainment/aquarium' или "
"'food/icecream')."

#: litegram.types.venue.Venue.google_place_id:1 of
msgid "*Optional*. Google Places identifier of the venue"
msgstr "*Необязательно*. Идентификатор места в Google Places"

#: litegram.types.venue.Venue.google_place_type:1 of
msgid ""
"*Optional*. Google Places type of the venue. (See `supported types "
"<https://developers.google.com/places/web-service/supported_types>`_.)"
msgstr ""
"*Необязательно*. Тип места в Google Places (см. `поддерживаемые типы "
"<https://developers.google.com/places/web-service/supported_types>`_)."

#~ msgid "Venue location. Can't be a live location"
#~ msgstr ""
