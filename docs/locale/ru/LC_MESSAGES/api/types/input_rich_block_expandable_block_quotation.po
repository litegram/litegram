#: ../../api/types/input_rich_block_expandable_block_quotation.rst:3
msgid "InputRichBlockExpandableBlockQuotation"
msgstr "InputRichBlockExpandableBlockQuotation"

#: litegram.types.input_rich_block_expandable_block_quotation.InputRichBlockExpandableBlockQuotation:1
#: of
msgid ""
"A block quotation, corresponding to the HTML tag :code:`<blockquote>` "
"with custom attribute :code:`\"expandable\"`."
msgstr ""
"Блочная цитата; соответствует HTML-тегу :code:`<blockquote>` с "
"пользовательским атрибутом :code:`\"expandable\"`."

#: litegram.types.input_rich_block_expandable_block_quotation.InputRichBlockExpandableBlockQuotation:3
#: of
msgid ""
"Source: "
"https://core.telegram.org/bots/api#inputrichblockexpandableblockquotation"
msgstr ""
"Источник: "
"https://core.telegram.org/bots/api#inputrichblockexpandableblockquotation"

#: litegram.types.input_rich_block_expandable_block_quotation.InputRichBlockExpandableBlockQuotation.type:1
#: of
msgid "Type of the block, always 'expandable_blockquote'"
msgstr "Тип блока, всегда 'expandable_blockquote'"

#: litegram.types.input_rich_block_expandable_block_quotation.InputRichBlockExpandableBlockQuotation.text:1
#: of
msgid "Content of the block"
msgstr "Содержимое блока"

#: litegram.types.input_rich_block_expandable_block_quotation.InputRichBlockExpandableBlockQuotation.credit:1
#: of
msgid "*Optional*. Credit of the block"
msgstr "*Необязательно*. Авторство блока"

