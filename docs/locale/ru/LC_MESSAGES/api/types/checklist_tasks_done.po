#: ../../api/types/checklist_tasks_done.rst:3
msgid "ChecklistTasksDone"
msgstr "ChecklistTasksDone"

#: litegram.types.checklist_tasks_done.ChecklistTasksDone:1 of
msgid ""
"Describes a service message about checklist tasks marked as done or not done."
msgstr ""
"Описывает сервисное сообщение о задачах чек-листа, отмеченных выполненными "
"или невыполненными."

#: litegram.types.checklist_tasks_done.ChecklistTasksDone:3 of
msgid "Source: https://core.telegram.org/bots/api#checklisttasksdone"
msgstr "Источник: https://core.telegram.org/bots/api#checklisttasksdone"

#: litegram.types.checklist_tasks_done.ChecklistTasksDone.checklist_message:1
#: of
msgid ""
"*Optional*. Message containing the checklist whose tasks were marked as done "
"or not done. Note that the :class:`litegram.types.message.Message` object in "
"this field will not contain the *reply_to_message* field even if it itself is"
" a reply."
msgstr ""
"*Необязательно*. Сообщение, содержащее чек-лист, задачи которого были "
"отмечены выполненными или невыполненными. Обратите внимание: объект "
":class:`litegram.types.message.Message` в этом поле не содержит поля "
"*reply_to_message*, даже если сам является ответом."

#: litegram.types.checklist_tasks_done.ChecklistTasksDone.marked_as_done_task_ids:1
#: of
msgid "*Optional*. Identifiers of the tasks that were marked as done"
msgstr "*Необязательно*. Идентификаторы задач, отмеченных выполненными"

#: litegram.types.checklist_tasks_done.ChecklistTasksDone.marked_as_not_done_task_ids:1
#: of
msgid "*Optional*. Identifiers of the tasks that were marked as not done"
msgstr "*Необязательно*. Идентификаторы задач, отмеченных невыполненными"
