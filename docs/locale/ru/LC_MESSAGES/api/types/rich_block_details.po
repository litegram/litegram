#: ../../api/types/rich_block_details.rst:3
msgid "RichBlockDetails"
msgstr "RichBlockDetails"

#: litegram.types.rich_block_details.RichBlockDetails:1 of
msgid ""
"An expandable block for details disclosure, corresponding to the HTML tag"
" :code:`<details>`."
msgstr ""
"Блок подробностей со сворачиванием; соответствует HTML-тегу "
":code:`<details>`."

#: litegram.types.rich_block_details.RichBlockDetails:3 of
msgid "Source: https://core.telegram.org/bots/api#richblockdetails"
msgstr "Источник: https://core.telegram.org/bots/api#richblockdetails"

#: litegram.types.rich_block_details.RichBlockDetails.type:1 of
msgid "Type of the block, always 'details'"
msgstr "Тип блока, всегда 'details'"

#: litegram.types.rich_block_details.RichBlockDetails.summary:1 of
msgid "Always shown summary of the block"
msgstr "Всегда отображаемая сводка блока"

#: litegram.types.rich_block_details.RichBlockDetails.blocks:1 of
msgid "Content of the block"
msgstr "Содержимое блока"

#: litegram.types.rich_block_details.RichBlockDetails.is_open:1 of
msgid ""
"*Optional*. :code:`True`, if the content of the block is visible by "
"default"
msgstr "*Необязательно*. :code:`True`, если содержимое блока по умолчанию раскрыто"

