#: ../../api/types/rich_block_mathematical_expression.rst:3
msgid "RichBlockMathematicalExpression"
msgstr "RichBlockMathematicalExpression"

#: litegram.types.rich_block_mathematical_expression.RichBlockMathematicalExpression:1
#: of
msgid ""
"A block with a mathematical expression in LaTeX format, corresponding to "
"the custom HTML tag :code:`<tg-math-block>`."
msgstr ""
"Блок с математическим выражением в формате LaTeX; соответствует "
"пользовательскому HTML-тегу :code:`<tg-math-block>`."

#: litegram.types.rich_block_mathematical_expression.RichBlockMathematicalExpression:3
#: of
msgid "Source: https://core.telegram.org/bots/api#richblockmathematicalexpression"
msgstr ""
"Источник: "
"https://core.telegram.org/bots/api#richblockmathematicalexpression"

#: litegram.types.rich_block_mathematical_expression.RichBlockMathematicalExpression.type:1
#: of
msgid "Type of the block, always 'mathematical_expression'"
msgstr "Тип блока, всегда 'mathematical_expression'"

#: litegram.types.rich_block_mathematical_expression.RichBlockMathematicalExpression.expression:1
#: of
msgid "The mathematical expression in LaTeX format"
msgstr "Математическое выражение в формате LaTeX"

