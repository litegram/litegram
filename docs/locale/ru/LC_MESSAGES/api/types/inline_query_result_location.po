#: ../../api/types/inline_query_result_location.rst:3
msgid "InlineQueryResultLocation"
msgstr "InlineQueryResultLocation"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation:1 of
msgid ""
"Represents a location on a map. By default, the location will be sent by the "
"user. Alternatively, you can use *input_message_content* to send a message "
"with the specified content instead of the location."
msgstr ""
"Представляет местоположение на карте. По умолчанию это местоположение будет "
"отправлено пользователем. В качестве альтернативы можно использовать "
"*input_message_content*, чтобы отправить сообщение с указанным содержимым "
"вместо местоположения."

#: litegram.types.inline_query_result_location.InlineQueryResultLocation:3 of
msgid "Source: https://core.telegram.org/bots/api#inlinequeryresultlocation"
msgstr "Источник: https://core.telegram.org/bots/api#inlinequeryresultlocation"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.type:1
#: of
msgid "Type of the result, must be *location*"
msgstr "Тип результата; должно быть *location*"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.id:1
#: of
msgid "Unique identifier for this result, 1-64 Bytes"
msgstr "Уникальный идентификатор этого результата, 1-64 байта"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.latitude:1
#: of
msgid "Location latitude in degrees"
msgstr "Широта местоположения в градусах"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.longitude:1
#: of
msgid "Location longitude in degrees"
msgstr "Долгота местоположения в градусах"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.title:1
#: of
msgid "Location title"
msgstr "Название местоположения"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.horizontal_accuracy:1
#: of
msgid ""
"*Optional*. The radius of uncertainty for the location, measured in meters; "
"0-1500"
msgstr "*Необязательно*. Радиус неточности местоположения в метрах; 0-1500"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.live_period:1
#: of
msgid ""
"*Optional*. Period in seconds during which the location can be updated, must "
"be between 60 and 86400, or 0x7FFFFFFF for live locations that can be edited "
"indefinitely"
msgstr ""
"*Необязательно*. Период обновления геолокации в секундах; от 60 до 86400 или "
"0x7FFFFFFF для live-локаций, которые можно изменять бесконечно"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.heading:1
#: of
msgid ""
"*Optional*. For live locations, a direction in which the user is moving, in "
"degrees. Must be between 1 and 360 if specified."
msgstr ""
"*Необязательно*. Для live-локаций — направление движения пользователя в "
"градусах. Должно быть от 1 до 360, если указано."

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.proximity_alert_radius:1
#: of
msgid ""
"*Optional*. For live locations, a maximum distance for proximity alerts about"
" approaching another chat member, in meters. Must be between 1 and 100000 if "
"specified."
msgstr ""
"*Необязательно*. Для live-локаций — максимальное расстояние для уведомлений о"
" приближении к другому участнику чата, в метрах. Должно быть от 1 до 100000, "
"если указано."

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.reply_markup:1
#: of
msgid ""
"*Optional*. `Inline keyboard <https://core.telegram.org/bots/features#inline-"
"keyboards>`_ attached to the message"
msgstr ""
"*Необязательно*. `Inline-клавиатура "
"<https://core.telegram.org/bots/features#inline-keyboards>`_, прикреплённая к"
" сообщению"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.input_message_content:1
#: of
msgid "*Optional*. Content of the message to be sent instead of the location"
msgstr ""
"*Необязательно*. Содержимое сообщения, которое будет отправлено вместо "
"местоположения"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.thumbnail_url:1
#: of
msgid "*Optional*. Url of the thumbnail for the result"
msgstr "*Необязательно*. URL превью результата"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.thumbnail_width:1
#: of
msgid "*Optional*. Thumbnail width"
msgstr "*Необязательно*. Ширина превью"

#: litegram.types.inline_query_result_location.InlineQueryResultLocation.thumbnail_height:1
#: of
msgid "*Optional*. Thumbnail height"
msgstr "*Необязательно*. Высота превью"

