#: ../../api/types/chat_location.rst:3
msgid "ChatLocation"
msgstr "ChatLocation"

#: litegram.types.chat_location.ChatLocation:1 of
msgid "Represents a location to which a chat is connected."
msgstr "Представляет местоположение, к которому привязан чат."

#: litegram.types.chat_location.ChatLocation:3 of
msgid "Source: https://core.telegram.org/bots/api#chatlocation"
msgstr "Источник: https://core.telegram.org/bots/api#chatlocation"

#: ../../docstring litegram.types.chat_location.ChatLocation.location:1 of
msgid ""
"The location to which the supergroup is connected. Can't be a live location."
msgstr ""
"Местоположение, к которому привязана супергруппа. Не может быть live-"
"локацией."

#: ../../docstring litegram.types.chat_location.ChatLocation.address:1 of
msgid "Location address; 1-64 characters, as defined by the chat owner"
msgstr "Адрес местоположения; 1-64 символа, задан владельцем чата"
