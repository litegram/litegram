#: ../../api/types/chat_share_theme_emoji.rst:3
msgid "ChatShareThemeEmoji"
msgstr "ChatShareThemeEmoji"

#: litegram.types.chat_share_theme_emoji.ChatShareThemeEmoji:1 of
msgid "The theme with emoji placed on a background."
msgstr "Тема с эмодзи, размещёнными на фоне."

#: litegram.types.chat_share_theme_emoji.ChatShareThemeEmoji:3 of
msgid "Source: https://core.telegram.org/bots/api#chatsharethemeemoji"
msgstr "Источник: https://core.telegram.org/bots/api#chatsharethemeemoji"

#: litegram.types.chat_share_theme_emoji.ChatShareThemeEmoji.type:1 of
msgid "Type of the theme, always 'emoji'"
msgstr "Тип темы, всегда 'emoji'"

#: litegram.types.chat_share_theme_emoji.ChatShareThemeEmoji.emojis:1 of
msgid "The emoji; 0-6 regular or custom emoji"
msgstr "Эмодзи; от 0 до 6 обычных или пользовательских эмодзи"

#: litegram.types.chat_share_theme_emoji.ChatShareThemeEmoji.background_backdrop_id:1
#: of
msgid ""
"*Optional*. Identifier of the backdrop used as the background; omitted if"
" the default background is used. Use "
":class:`litegram.methods.get_chat_share_theme_backdrops.GetChatShareThemeBackdrops`"
" to get details about the backdrop."
msgstr ""
"*Необязательно*. Идентификатор фона, используемого в качестве фона темы; "
"отсутствует, если используется фон по умолчанию. Используйте "
":class:`litegram.methods.get_chat_share_theme_backdrops.GetChatShareThemeBackdrops`,"
" чтобы получить сведения о фоне."

