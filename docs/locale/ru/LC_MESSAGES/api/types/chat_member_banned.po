#: ../../api/types/chat_member_banned.rst:3
msgid "ChatMemberBanned"
msgstr "ChatMemberBanned"

#: litegram.types.chat_member_banned.ChatMemberBanned:1 of
msgid ""
"Represents a `chat member <https://core.telegram.org/bots/api#chatmember>`_ "
"that was banned in the chat and can't return to the chat or view chat "
"messages."
msgstr ""
"Представляет `участника чата "
"<https://core.telegram.org/bots/api#chatmember>`_, заблокированного в чате и "
"не имеющего возможности вернуться в чат или просматривать сообщения чата."

#: litegram.types.chat_member_banned.ChatMemberBanned:3 of
msgid "Source: https://core.telegram.org/bots/api#chatmemberbanned"
msgstr "Источник: https://core.telegram.org/bots/api#chatmemberbanned"

#: litegram.types.chat_member_banned.ChatMemberBanned.status:1 of
msgid "The member's status in the chat, always 'kicked'"
msgstr "Статус участника в чате, всегда 'kicked'"

#: litegram.types.chat_member_banned.ChatMemberBanned.user:1 of
msgid "Information about the user"
msgstr "Информация о пользователе"

#: litegram.types.chat_member_banned.ChatMemberBanned.until_date:1 of
msgid ""
"Date when restrictions will be lifted for this user; Unix time. If 0, then "
"the user is banned forever."
msgstr ""
"Дата снятия ограничений для пользователя; Unix time. Если 0, пользователь "
"забанен навсегда."

#~ msgid ""
#~ "Date when restrictions will be lifted for this user; Unix time. If 0, then "
#~ "the user is banned forever"
#~ msgstr ""
