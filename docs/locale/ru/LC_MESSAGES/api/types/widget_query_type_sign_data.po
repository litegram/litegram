#: ../../api/types/widget_query_type_sign_data.rst:3
msgid "WidgetQueryTypeSignData"
msgstr "WidgetQueryTypeSignData"

#: litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData:1 of
msgid ""
"The query contains data signed by a TON wallet of the user who sent the "
"query. The data is signed for the domain :code:`bot<bot_id>`, where "
":code:`<bot_id>` is the identifier of the bot."
msgstr ""
"Запрос содержит данные, подписанные TON-кошельком пользователя, "
"отправившего запрос. Данные подписаны для домена :code:`bot<bot_id>`, где"
" :code:`<bot_id>` — идентификатор бота."

#: litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData:3 of
msgid "Source: https://core.telegram.org/bots/api#widgetquerytypesigndata"
msgstr "Источник: https://core.telegram.org/bots/api#widgetquerytypesigndata"

#: litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData.type:1 of
msgid "Type of the query, always 'sign_data'"
msgstr "Тип запроса, всегда 'sign_data'"

#: litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData.wallet:1
#: of
msgid "The wallet that signed the data"
msgstr "Кошелёк, подписавший данные"

#: litegram.types.widget_query_type_sign_data.WidgetQueryTypeSignData.sign_data:1
#: of
msgid "JSON-serialized signed data"
msgstr "Подписанные данные в формате JSON"

