#: ../../api/types/chat_boost_source_gift_code.rst:3
msgid "ChatBoostSourceGiftCode"
msgstr "ChatBoostSourceGiftCode"

#: litegram.types.chat_boost_source_gift_code.ChatBoostSourceGiftCode:1 of
msgid ""
"The boost was obtained by the creation of Telegram Premium gift codes to "
"boost a chat. Each such code boosts the chat 4 times for the duration of the "
"corresponding Telegram Premium subscription."
msgstr ""
"Буст получен за создание кодов Telegram Premium для буста чата. Каждый такой "
"код бустит чат 4 раза в течение действия соответствующей подписки Telegram "
"Premium."

#: litegram.types.chat_boost_source_gift_code.ChatBoostSourceGiftCode:3 of
msgid "Source: https://core.telegram.org/bots/api#chatboostsourcegiftcode"
msgstr "Источник: https://core.telegram.org/bots/api#chatboostsourcegiftcode"

#: ../../docstring
#: litegram.types.chat_boost_source_gift_code.ChatBoostSourceGiftCode.source:1
#: of
msgid "Source of the boost, always 'gift_code'"
msgstr "Источник буста, всегда 'gift_code'"

#: ../../docstring
#: litegram.types.chat_boost_source_gift_code.ChatBoostSourceGiftCode.user:1 of
msgid "User for which the gift code was created"
msgstr "Пользователь, для которого создан код подарка"
