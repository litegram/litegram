#: ../../api/types/widget_query_type_data.rst:3
msgid "WidgetQueryTypeData"
msgstr "WidgetQueryTypeData"

#: litegram.types.widget_query_type_data.WidgetQueryTypeData:1 of
msgid "The query contains data for the bot."
msgstr "Запрос содержит данные для бота."

#: litegram.types.widget_query_type_data.WidgetQueryTypeData:3 of
msgid "Source: https://core.telegram.org/bots/api#widgetquerytypedata"
msgstr "Источник: https://core.telegram.org/bots/api#widgetquerytypedata"

#: litegram.types.widget_query_type_data.WidgetQueryTypeData.type:1 of
msgid "Type of the query, always 'data'"
msgstr "Тип запроса, всегда 'data'"

#: litegram.types.widget_query_type_data.WidgetQueryTypeData.wallet_card:1 of
msgid ""
"*Optional*. TON wallet card of the user who sent the query, if it was "
"sent to the bot along with the query"
msgstr ""
"*Необязательно*. Карточка TON-кошелька пользователя, отправившего запрос,"
" если она была передана боту вместе с запросом"

