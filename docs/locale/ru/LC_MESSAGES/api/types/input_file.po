#: ../../api/types/input_file.rst:3
msgid "InputFile"
msgstr "InputFile"

#: litegram.types.input_file.InputFile:1 of
msgid ""
"This object represents the contents of a file to be uploaded. Must be posted "
"using multipart/form-data in the usual way that files are uploaded via the "
"browser."
msgstr ""
"Этот объект представляет содержимое загружаемого файла. Должен отправляться "
"через multipart/form-data обычным способом загрузки файлов через браузер."

#: litegram.types.input_file.InputFile:3 of
msgid "Source: https://core.telegram.org/bots/api#inputfile"
msgstr "Источник: https://core.telegram.org/bots/api#inputfile"

#: litegram.types.input_file.BufferedInputFile.from_file:1 of
msgid "Create buffer from file"
msgstr "Создаёт буфер из файла"

#: litegram.types.input_file.BufferedInputFile.from_file of
msgid "Parameters"
msgstr "Параметры"

#: litegram.types.input_file.BufferedInputFile.from_file:3 of
msgid "Path to file"
msgstr "Путь к файлу"

#: litegram.types.input_file.BufferedInputFile.from_file:4 of
msgid ""
"Filename to be propagated to telegram. By default, will be parsed from path"
msgstr ""
"Имя файла, которое будет передано в Telegram. По умолчанию извлекается из "
"пути"

#: litegram.types.input_file.BufferedInputFile.from_file:6 of
msgid "Uploading chunk size"
msgstr "Размер загружаемого фрагмента"

#: litegram.types.input_file.BufferedInputFile.from_file of
msgid "Returns"
msgstr "Возвращает"

#: litegram.types.input_file.BufferedInputFile.from_file:7 of
msgid "instance of :obj:`BufferedInputFile`"
msgstr "экземпляр :obj:`BufferedInputFile`"
