#: ../../api/types/rich_block_animation.rst:3
msgid "RichBlockAnimation"
msgstr "RichBlockAnimation"

#: litegram.types.rich_block_animation.RichBlockAnimation:1 of
msgid "A block with an animation, corresponding to the HTML tag :code:`<video>`."
msgstr "Блок с анимацией; соответствует HTML-тегу :code:`<video>`."

#: litegram.types.rich_block_animation.RichBlockAnimation:3 of
msgid "Source: https://core.telegram.org/bots/api#richblockanimation"
msgstr "Источник: https://core.telegram.org/bots/api#richblockanimation"

#: litegram.types.rich_block_animation.RichBlockAnimation.type:1 of
msgid "Type of the block, always 'animation'"
msgstr "Тип блока, всегда 'animation'"

#: litegram.types.rich_block_animation.RichBlockAnimation.animation:1 of
msgid "The animation"
msgstr "Анимация"

#: litegram.types.rich_block_animation.RichBlockAnimation.has_spoiler:1 of
msgid ""
"*Optional*. :code:`True`, if the media preview is covered by a spoiler "
"animation"
msgstr "*Необязательно*. :code:`True`, если медиа скрыто под анимацией спойлера"

#: litegram.types.rich_block_animation.RichBlockAnimation.caption:1 of
msgid "*Optional*. Caption of the block"
msgstr "*Необязательно*. Подпись блока"

