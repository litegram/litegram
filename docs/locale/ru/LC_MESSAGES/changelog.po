msgid "1.1.0 (2026-11-20)"
msgstr "1.0.0 (2026-01-20)"

#: ../../../CHANGES.rst:23 ../../../CHANGES.rst:101
msgid "Features"
msgstr "Нововведения"

#: ../../../CHANGES.rst:25
msgid ""
"Added full support for Telegram Bot API 10.4 (released on November 9, "
"2026), covering all changes from 9.4 through 10.4: rich messages "
"(RichMessage/RichText/RichBlock families), widgets "
"(Widget/WidgetQuery/SharedWidgetQuery), ephemeral messages, managed bots,"
" chat join request queries, poll voting enhancements, TON wallet cards "
"and the rest of the new types and methods."
msgstr ""

#: ../../../CHANGES.rst:29
msgid ""
"``HttpxSession`` now accepts ``max_connections`` and "
"``max_keepalive_connections`` for connection-pool tuning in high-load "
"production."
msgstr ""

#: ../../../CHANGES.rst:30
msgid ""
"File uploads stream through a Litegram-owned async multipart encoder: "
"bounded memory and guaranteed source cleanup instead of the incompatible "
"``files=`` path."
msgstr ""

#: ../../../CHANGES.rst:31
msgid ""
"Mini App init-data validators accept ``auth_date_timeout`` to reject "
"stale init data (replay protection)."
msgstr ""

#: ../../../CHANGES.rst:32
msgid ""
"Polling shutdown drains in-flight update handlers (``drain_timeout``, "
"default 30 s) before closing sessions and FSM storage."
msgstr ""

#: ../../../CHANGES.rst:35 ../../../CHANGES.rst:106
msgid "Bugfixes"
msgstr "Исправления ошибок"

#: ../../../CHANGES.rst:37
msgid ""
"Fixed ``Update.purchased_paid_media`` field name (was "
"``paid_media_purchased``), so the field now correctly deserializes real "
"Telegram payloads and the dispatcher routes the update."
msgstr ""

#: ../../../CHANGES.rst:38
msgid ""
"Fixed deprecated field handling (``Default``/``Field(alias=...)``) across"
" the API layer and preserved curated defaults (e.g. "
"``RefundedPayment.currency``)."
msgstr ""

#: ../../../CHANGES.rst:39
msgid ""
"Restore bounded defaults for the HTTPX connection pool while allowing "
"explicit overrides."
msgstr ""

#: ../../../CHANGES.rst:40
msgid ""
"Route all six new update types through the dispatcher and populate their "
"event context where available."
msgstr ""

#: ../../../CHANGES.rst:41
msgid ""
"Decode ``answerGuestQuery`` as ``SentGuestMessage`` and managed-bot token"
" responses as strings."
msgstr ""

#: ../../../CHANGES.rst:42
msgid ""
"Fix async callable dispatch, class-based error reporting, chat-scoped FSM"
" resolution, nested state names, and keyboard markup option round-trips."
msgstr ""

#: ../../../CHANGES.rst:43
msgid ""
"Reject malformed encoded deep links and third-party Mini App signatures "
"without propagating decoding errors."
msgstr ""

#: ../../../CHANGES.rst:44
msgid ""
"Isolate per-handler context: data injected by a skipped handler's filters"
" no longer leaks into subsequent handlers or outer middlewares."
msgstr ""

#: ../../../CHANGES.rst:45
msgid ""
"Escape URLs in HTML attributes and Markdown link destinations; validate "
"``pre_language`` tags."
msgstr ""

#: ../../../CHANGES.rst:46
msgid "Use constant-time comparison in Login Widget signature validation."
msgstr ""

#: ../../../CHANGES.rst:47
msgid ""
"``create_channel_bot_link`` generates ``?startchannel`` links; "
"``startapp`` payloads follow the 512-character limit."
msgstr ""

#: ../../../CHANGES.rst:48
msgid ""
"``ChatActionSender`` propagates ``business_connection_id`` and collects "
"background worker failures."
msgstr ""

#: ../../../CHANGES.rst:51
msgid "Improved Documentation"
msgstr ""

#: ../../../CHANGES.rst:53
msgid ""
"Added API reference pages for all new types and methods, regenerated "
"enums/unions docs."
msgstr ""

#: ../../../CHANGES.rst:56 ../../../CHANGES.rst:109
msgid "Misc"
msgstr "Разное"

#: ../../../CHANGES.rst:58
msgid ""
"Added behavioral tests for the new Bot API 10.4 surface (rich text "
"unions, widget queries, purchased paid media regression, new bot methods)"
" and an UpdateType/Update consistency test."
msgstr ""

